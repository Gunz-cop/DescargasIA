{
  "name": "fuenteai",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-18",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "ai": { "binding": "AI" },
  "kv_namespaces": [
    {
      "binding": "HW_CACHE",
      "id": "0b8817010be342c89053895a59054508"
    }
  ]
}
