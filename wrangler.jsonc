{
  "name": "fuenteai",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-18",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "ai": { "binding": "AI" },
  "kv_namespaces": [
    {
      "binding": "HW_CACHE",
      "id": "0a1b2c3d4e5f60718293a4b5c6d7e8f9"
    }
  ]
}
