{
  "name": "descargas-ia-directorio",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "shorten": "node scripts/shorten-official-links.mjs",
    "test": "node --test \"tests/**/*.test.mjs\" && npx tsx --test \"tests/**/*.test.ts\"",
    "test:build": "node --test tests/agents/catalogo-campos.test.mjs tests/og-images.test.mjs tests/guias-rutas.test.mjs",
    "build": "npm run shorten && npm run catalog:audit && npm run hw:audit && npm test && npm run agents:skills && npm run build-og && astro build && npm run test:build && npm run links:audit",
    "build:no-shorten": "npm run catalog:audit && npm run hw:audit && npm test && npm run agents:skills && npm run build-og && astro build && npm run test:build && npm run links:audit",
    "preview": "astro preview",
    "astro": "astro",
    "links:audit": "node scripts/audit-internal-links.mjs",
    "catalog:audit": "node scripts/audit-catalog.mjs",
    "build-og": "node scripts/build-og-images.mjs",
    "agents:skills": "node scripts/build-agent-skills-index.mjs",
    "hw:audit": "node scripts/audit-hardware-data.mjs",
    "hw:build": "node scripts/hardware/build-gpus.mjs && node scripts/hardware/build-quants.mjs && node scripts/hardware/build-models.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.3.8",
    "@astrojs/sitemap": "^3.7.3",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.7",
    "satori": "^0.33.4",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "sdi-cli": "^0.1.0",
    "tsx": "^4.19.1",
    "typescript": "7.0.2",
    "wrangler": "^4.126.0"
  }
}
