    "tailwindcss": "^4.3.0",
    "zod": "^3.23.8"
  },
  "overrides": {
    "vite": "7.3.5"
  },
  "devDependencies": {
    "sdi-cli": "^0.1.0",
    "wrangler": "^4.121.0"
  }
}
