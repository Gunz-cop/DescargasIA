{
  "name": "descargas-ia-directorio",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "shorten": "node scripts/shorten-official-links.mjs",
