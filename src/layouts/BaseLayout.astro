---
// src/layouts/BaseLayout.astro
import '../styles/global.css';
import { useTranslations } from '../i18n/ui';
import { CATEGORIES, type Lang } from '../utils/brand';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogType?: string;
  ogImage?: string;
  jsonLd?: Record<string, any> | Record<string, any>[];
  lang?: Lang;
  alternates?: Array<{ lang: string; url: string }>;
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalUrl = Astro.url.href,
  ogType = 'website',
  ogImage = 'https://fuenteai.com/og-default.png',
  jsonLd,
  lang = 'es',
  alternates = [],
  noindex = false
} = Astro.props;

const t = useTranslations(lang);

const hreflangMap: Record<string, string> = { es: 'es-ES', sv: 'sv-SE', it: 'it-IT' };
const ogLocaleMap: Record<string, string> = { es: 'es_ES', sv: 'sv_SE', it: 'it_IT' };

const home = `/${lang}`;

// El selector de idioma usa URLs reales calculadas en build. Si una página no
// existe en el idioma destino se enlaza su portada en vez de provocar un 404.
const switcherLangs: Array<{ code: Lang; label: string; available: boolean; url: string }> = (
  ['es', 'sv'] as const
).map((code) => {
  const alt = alternates.find((entry) => entry.lang === code);
  return {
    code,
    label: code === 'es' ? 'Español' : 'Svenska',
    available: Boolean(alt),
    url: alt?.url ?? `/${code}`
  };
});

const legalLinks = [
  { href: `/${lang}/acerca-de`, label: t('footer.about') },
  { href: `/${lang}/aviso-legal`, label: t('footer.legal') },
  { href: `/${lang}/privacidad`, label: t('footer.privacy') },
  { href: `/${lang}/cookies`, label: t('footer.cookies') }
];

const year = new Date().getFullYear();
const rightsLine = lang === 'sv'
  ? 'Alla varumärken tillhör sina respektive ägare. FuenteAI är inte anslutet till dem.'
  : lang === 'it'
    ? 'Tutti i marchi appartengono ai rispettivi proprietari. FuenteAI non è affiliata a essi.'
    : 'Todas las marcas pertenecen a sus respectivos propietarios. FuenteAI no está afiliada a ellas.';
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Tema aplicado antes del primer pintado (sin parpadeo) -->
    <script is:inline>
      (() => {
        let theme = 'light';
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') {
            theme = stored;
          } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            theme = 'dark';
          }
        } catch (error) {
          /* localStorage bloqueado: se mantiene el tema claro por defecto */
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>

    <!-- SEO básico -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {(noindex || lang === 'it') && <meta name="robots" content="noindex" />}

    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0e10" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />

    <!-- Alternates hreflang -->
    {alternates.map(({ lang: altLang, url }) => (
      <link rel="alternate" hreflang={hreflangMap[altLang] ?? altLang} href={url} />
    ))}
    {(() => {
      const defaultAlt = alternates.find((alt) => alt.lang === 'es')?.url || Astro.url.origin;
      return <link rel="alternate" hreflang="x-default" href={defaultAlt} />;
    })()}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Tipografía: sólo la serif de titulares y la monoespaciada de datos.
         El texto de interfaz usa la pila del sistema (0 bytes). -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;700&display=swap"
    />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="FuenteAI" />
    <meta property="og:locale" content={ogLocaleMap[lang] ?? 'es_ES'} />
    <meta property="og:site_name" content="FuenteAI" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd && (Array.isArray(jsonLd) ? jsonLd : [jsonLd]).map(schema => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#contenido" class="skip-link">{t('a11y.skip')}</a>

    <!-- CABECERA -->
    <header class="sticky top-0 z-40 border-b border-brand-hairline bg-brand-bg/85 backdrop-blur-md">
      <div class="mx-auto flex h-16 max-w-6xl items-center gap-3 px-5">
        <a href={home} class="group flex items-center gap-2.5" aria-label={`FuenteAI — ${t('nav.home')}`}>
          <svg class="h-[26px] w-[26px] text-brand-primary" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="2.6" y="2.6" width="18.8" height="18.8" rx="5.4" stroke="currentColor" stroke-width="1.5" opacity=".4" />
            <path d="M7.4 12.3 10.6 15.5 16.8 8.9" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span class="display text-[22px] text-brand-text transition-colors group-hover:text-brand-primary">
            Fuente<span class="font-mono text-[0.82em] font-bold tracking-tight">AI</span>
          </span>
        </a>

        <!-- Navegación de escritorio -->
        <nav class="ml-4 hidden items-center gap-1 md:flex" aria-label={t('nav.sections')}>
          <a
            href={`${home}#directorio`}
            class="rounded-md px-2.5 py-2 text-[14px] font-medium text-brand-text-muted transition-colors hover:bg-brand-surface-sunken hover:text-brand-text"
          >{t('nav.directory')}</a>

          <details class="group/cat relative" name="header-menus">
            <summary
              class="flex cursor-pointer list-none items-center gap-1.5 rounded-md px-2.5 py-2 text-[14px] font-medium text-brand-text-muted transition-colors hover:bg-brand-surface-sunken hover:text-brand-text"
            >
              {t('nav.categories')}
              <svg class="details-marker h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </summary>
            <div class="absolute left-0 top-full z-50 mt-1 w-64 rounded-lg border border-brand-card-border bg-brand-surface p-1.5 shadow-overlay">
              {CATEGORIES.map((cat) => (
                <a
                  href={`/${lang}/categoria/${cat.slug}`}
                  class="flex items-center gap-2.5 rounded-md px-2.5 py-2 text-[14px] text-brand-text transition-colors hover:bg-brand-surface-sunken"
                >
                  <span class="h-1.5 w-1.5 shrink-0 rounded-full" style={`background:${cat.tone}`} aria-hidden="true"></span>
                  {cat.label[lang]}
                </a>
              ))}
            </div>
          </details>

          <a
            href={`/${lang}/acerca-de`}
            class="rounded-md px-2.5 py-2 text-[14px] font-medium text-brand-text-muted transition-colors hover:bg-brand-surface-sunken hover:text-brand-text"
          >{t('nav.about')}</a>
        </nav>

        <div class="ml-auto flex items-center gap-1.5">
          <!-- Idioma -->
          <details class="relative" name="header-menus">
            <summary
              class="flex min-h-10 cursor-pointer list-none items-center gap-1.5 rounded-md border border-brand-card-border bg-brand-surface px-2.5 text-[13px] font-medium text-brand-text-muted transition-colors hover:text-brand-text"
              aria-label={t('lang.change')}
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="M3 12h18M12 3c2.5 2.7 2.5 15.3 0 18M12 3c-2.5 2.7-2.5 15.3 0 18" />
              </svg>
              <span class="uppercase">{lang}</span>
            </summary>
            <div class="absolute right-0 top-full z-50 mt-1 w-52 rounded-lg border border-brand-card-border bg-brand-surface p-1.5 shadow-overlay">
              {switcherLangs.map((option) => (
                <a
                  href={option.url}
                  hreflang={option.code}
                  aria-current={option.code === lang ? 'true' : undefined}
                  class="flex items-center justify-between gap-2 rounded-md px-2.5 py-2 text-[14px] text-brand-text transition-colors hover:bg-brand-surface-sunken aria-[current]:font-semibold aria-[current]:text-brand-primary"
                >
                  {option.label}
                </a>
              ))}
              <span class="flex items-center gap-2 rounded-md px-2.5 py-2 text-[14px] text-brand-text-subtle">
                Italiano <span class="data-tag">({t('lang.soon')})</span>
              </span>
            </div>
          </details>

          <!-- Tema -->
          <button
            type="button"
            id="theme-toggle"
            class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-brand-card-border bg-brand-surface text-brand-text-muted transition-colors hover:text-brand-text"
            aria-label={t('theme.toggle')}
          >
            <svg class="theme-icon-sun h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <circle cx="12" cy="12" r="4.2" />
              <path d="M12 3v2m0 14v2M3 12h2m14 0h2M5.6 5.6l1.4 1.4m10 10 1.4 1.4m0-12.8-1.4 1.4m-10 10-1.4 1.4" stroke-linecap="round" />
            </svg>
            <svg class="theme-icon-moon h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M20 14.2A8.2 8.2 0 0 1 9.8 4a8.4 8.4 0 1 0 10.2 10.2Z" stroke-linejoin="round" />
            </svg>
          </button>

          <!-- Menú móvil -->
          <details class="md:hidden" id="mobile-menu" name="header-menus">
            <summary
              class="inline-flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-md border border-brand-card-border bg-brand-surface text-brand-text-muted transition-colors hover:text-brand-text"
              aria-label={t('nav.open-menu')}
            >
              <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
              </svg>
            </summary>
            <nav
              class="absolute inset-x-0 top-16 z-50 max-h-[calc(100dvh-4rem)] overflow-y-auto border-b border-brand-card-border bg-brand-surface p-4 shadow-overlay"
              aria-label={t('nav.menu')}
            >
              <a
                href={`${home}#directorio`}
                class="block rounded-md px-3 py-2.5 text-[15px] font-medium text-brand-text hover:bg-brand-surface-sunken"
              >{t('nav.directory')}</a>
              <p class="eyebrow mt-4 px-3 py-1 text-brand-text-subtle">{t('nav.categories')}</p>
              {CATEGORIES.map((cat) => (
                <a
                  href={`/${lang}/categoria/${cat.slug}`}
                  class="flex items-center gap-2.5 rounded-md px-3 py-2.5 text-[15px] text-brand-text hover:bg-brand-surface-sunken"
                >
                  <span class="h-1.5 w-1.5 shrink-0 rounded-full" style={`background:${cat.tone}`} aria-hidden="true"></span>
                  {cat.label[lang]}
                </a>
              ))}
              <p class="eyebrow mt-4 px-3 py-1 text-brand-text-subtle">{t('nav.legal')}</p>
              {legalLinks.map((link) => (
                <a
                  href={link.href}
                  class="block rounded-md px-3 py-2.5 text-[15px] text-brand-text hover:bg-brand-surface-sunken"
                >{link.label}</a>
              ))}
            </nav>
          </details>
        </div>
      </div>
    </header>

    <!-- CONTENIDO -->
    <main id="contenido" class="mx-auto w-full max-w-6xl flex-1 px-5 pb-16">
      <slot />
    </main>

    <!-- PIE -->
    <footer class="border-t border-brand-hairline bg-brand-surface-sunken">
      <div class="mx-auto grid max-w-6xl gap-10 px-5 py-12 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr]">
        <div>
          <span class="display flex items-center gap-2 text-[20px]">
            <svg class="h-5 w-5 text-brand-primary" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="2.6" y="2.6" width="18.8" height="18.8" rx="5.4" stroke="currentColor" stroke-width="1.5" opacity=".4" />
              <path d="M7.4 12.3 10.6 15.5 16.8 8.9" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span>Fuente<span class="font-mono font-bold">AI</span></span>
          </span>
          <p class="mt-3 max-w-md text-[13px] leading-6 text-brand-text-muted">
            {t('footer.disclaimer')}
          </p>
        </div>

        <nav aria-label={t('nav.categories')}>
          <h2 class="eyebrow text-brand-text-subtle">{t('nav.categories')}</h2>
          <ul class="mt-3 grid gap-1.5" role="list">
            {CATEGORIES.map((cat) => (
              <li>
                <a
                  href={`/${lang}/categoria/${cat.slug}`}
                  class="text-[13px] text-brand-text-muted transition-colors hover:text-brand-text"
                >{cat.label[lang]}</a>
              </li>
            ))}
          </ul>
        </nav>

        <nav aria-label={t('nav.legal')}>
          <h2 class="eyebrow text-brand-text-subtle">{t('nav.legal')}</h2>
          <ul class="mt-3 grid gap-1.5" role="list">
            {legalLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-[13px] text-brand-text-muted transition-colors hover:text-brand-text"
                >{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <div class="border-t border-brand-hairline">
        <p class="mx-auto max-w-6xl px-5 py-5 text-[12px] leading-5 text-brand-text-subtle">
          © {year} FuenteAI. {rightsLine}
        </p>
      </div>
    </footer>

    <script is:inline>
      // Tema: alterna y persiste. El estado inicial ya se aplicó en <head>.
      const themeToggle = document.getElementById('theme-toggle');
      themeToggle?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch (error) {
          /* sin persistencia disponible */
        }
      });

      // Cierra los menús <details> al hacer clic fuera o al pulsar Escape.
      const menus = Array.from(document.querySelectorAll('header details'));
      document.addEventListener('click', (event) => {
        menus.forEach((menu) => {
          if (menu.open && !menu.contains(event.target)) menu.open = false;
        });
      });
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        menus.forEach((menu) => {
          if (menu.open) {
            menu.open = false;
            menu.querySelector('summary')?.focus();
          }
        });
      });
    </script>
  </body>
</html>
