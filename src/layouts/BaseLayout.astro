---
// src/layouts/BaseLayout.astro — §6 Shell
// Fondo con halos, cabecera, pie de confianza de tres columnas.
import '../styles/global.css';
import Motion from '../components/Motion.astro';
import WebMcp from '../components/WebMcp.astro';
import { useTranslations } from '../i18n/ui';
import { CATEGORIES, type Lang } from '../utils/brand';
import { homeUrl, categoryUrl, pageUrl, directoryUrl, hardwareUrl } from '../utils/links';
import { hasMarkdownMirror, markdownPathFor } from '../utils/agent-content';
import { getTranslatedTools } from '../utils/tools';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogType?: string;
  ogImage?: string;
  jsonLd?: Record<string, any> | Record<string, any>[];
  lang?: Lang;
  alternates?: Array<{ lang: string; url: string }>;
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalUrl = Astro.url.href,
  ogType = 'website',
  ogImage = 'https://fuenteai.com/og-default.png',
  jsonLd,
  lang = 'es',
  alternates = [],
  noindex = false
} = Astro.props;

const t = useTranslations(lang);

const langTools = await getTranslatedTools(lang);

// El contador de la cabecera se deriva del catálogo, nunca se escribe a mano.
const verifiedCount = langTools.length;

const esAlternate = alternates.find((alt) => alt.lang === 'es');

const hreflangMap: Record<string, string> = { es: 'es-ES', sv: 'sv-SE', it: 'it-IT' };
const ogLocaleMap: Record<string, string> = { es: 'es_ES', sv: 'sv_SE', it: 'it_IT' };

// Espejo Markdown de ESTA pagina. Es la misma URL que sirve el Worker cuando
// llega `Accept: text/markdown`; declararla en el head le ahorra al agente
// tener que negociar para descubrir que existe. Solo se anuncia si de verdad
// se generó: las paginas legales y el 404 no tienen espejo.
// Ver docs/agent-readiness.md.
const markdownUrl = hasMarkdownMirror(Astro.url.pathname, langTools.map((tool) => tool.slug))
  ? markdownPathFor(Astro.url.pathname)
  : null;

const home = homeUrl(lang);
const directory = directoryUrl(lang);
const hardware = hardwareUrl(lang);

// URLs reales calculadas en build: si la página no existe en el idioma destino
// se enlaza su portada en vez de provocar un 404.
const switcherLangs = (['es', 'sv', 'it'] as const).map((code) => {
  const alt = alternates.find((entry) => entry.lang === code);
  return {
    code,
    label: code === 'es' ? 'Español' : code === 'sv' ? 'Svenska' : 'Italiano',
    url: alt?.url ?? homeUrl(code)
  };
});

const legalLinks = [
  { href: pageUrl(lang, 'acerca-de'), label: t('footer.about') },
  { href: pageUrl(lang, 'aviso-legal'), label: t('footer.legal') },
  { href: pageUrl(lang, 'privacidad'), label: t('footer.privacy') },
  { href: pageUrl(lang, 'cookies'), label: t('footer.cookies') }
];

const trustColumns = [
  { title: t('trust.no-clones'), body: t('trust.no-clones.body') },
  { title: t('trust.weekly'), body: t('trust.weekly.body') },
  { title: t('trust.no-sponsors'), body: t('trust.no-sponsors.body') }
];

const year = new Date().getFullYear();
const rightsLine = lang === 'sv'
  ? 'Alla varumärken tillhör sina respektive ägare. FuenteAI är inte anslutet till dem.'
  : lang === 'it'
    ? 'Tutti i marchi appartengono ai rispettivi proprietari. FuenteAI non è affiliata a essi.'
    : 'Todas las marcas pertenecen a sus respectivos propietarios. FuenteAI no está afiliada a ellas.';
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {markdownUrl && !noindex && <link rel="alternate" type="text/markdown" href={markdownUrl} />}

    {/* Descubrimiento para agentes: manifiesto de capacidades del dominio
        (ARD) y resumen del sitio. Ver docs/agent-readiness.md. */}
    <link rel="ai-catalog" href="/.well-known/ai-catalog.json" />
    <link rel="describedby" type="text/plain" href="/llms.txt" />
    {noindex && <meta name="robots" content="noindex" />}

    <meta name="theme-color" content="#04120e" />
    <meta name="color-scheme" content="dark" />

    <!-- §2 Fuentes autoalojadas: se precargan los dos cortes que aparecen en
         el primer viewport; el resto los pide el navegador por unicode-range. -->
    <link rel="preload" href="/fonts/space-grotesk-700-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-mono-500-latin.woff2" as="font" type="font/woff2" crossorigin />

    {alternates.map(({ lang: altLang, url }) => (
      <link rel="alternate" hreflang={hreflangMap[altLang] ?? altLang} href={url} />
    ))}
    {/* x-default = version ES de ESTA pagina. Si no existe en ES no se
        inventa un x-default apuntando a la portada: seria una alternativa
        falsa y Google descarta el bloque hreflang entero. */}
    {esAlternate && <link rel="alternate" hreflang="x-default" href={esAlternate.url} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="FuenteAI" />
    <meta property="og:locale" content={ogLocaleMap[lang] ?? 'es_ES'} />
    <meta property="og:site_name" content="FuenteAI" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd && (Array.isArray(jsonLd) ? jsonLd : [jsonLd]).map(schema => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    ))}

    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
  </head>
  <body class="no-js flex min-h-screen flex-col">
    <a href="#contenido" class="skip-link">{t('a11y.skip')}</a>

    <!-- §3.1 Respiración de fondo: dos halos radiales, único gradiente del sistema -->
    <div class="fai-halos" aria-hidden="true">
      <span class="fai-halo fai-halo--signal"></span>
      <span class="fai-halo fai-halo--find"></span>
    </div>

    <!-- CABECERA -->
    <header class="sticky top-0 z-40 border-b border-fai-line bg-[#04120e]/85 backdrop-blur-md [-webkit-backdrop-filter:blur(12px)]">
      <div class="mx-auto flex h-16 max-w-[1240px] items-center gap-4 px-5">
        <a href={home} class="group -mx-2 flex min-h-11 items-center gap-2.5 rounded-md px-2" aria-label={`FuenteAI — ${t('nav.home')}`}>
          <span class="fai-avatar fai-avatar--find h-6 w-6 rounded-[7px]" aria-hidden="true"></span>
          <span class="text-[17px] font-bold tracking-[-0.02em] text-fai-ink transition-colors group-hover:text-fai-signal">
            FuenteAI
          </span>
        </a>

        <nav class="ml-3 hidden items-center gap-1 md:flex" aria-label={t('nav.sections')}>
          <a href={directory} class="rounded-md px-3 py-2 text-[14px] text-fai-muted transition-colors hover:text-fai-ink">
            {t('nav.directory')}
          </a>

          <a href={hardware} class="rounded-md px-3 py-2 text-[14px] text-fai-muted transition-colors hover:text-fai-ink">
            {t('hw.nav')}
          </a>

          <details class="relative" name="header-menus">
            <summary class="flex cursor-pointer list-none items-center gap-1.5 rounded-md px-3 py-2 text-[14px] text-fai-muted transition-colors hover:text-fai-ink">
              {t('nav.categories')}
              <svg class="details-marker h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </summary>
            <div class="absolute left-0 top-full z-50 mt-1 w-64 rounded-[14px] border border-fai-line bg-fai-surface p-1.5 shadow-2xl">
              {CATEGORIES.map((cat) => (
                <a href={categoryUrl(lang, cat.slug)} class="flex min-h-11 items-center rounded-md px-3 text-[14px] text-fai-ink transition-colors hover:bg-fai-card hover:text-fai-signal">
                  {cat.label[lang]}
                </a>
              ))}
            </div>
          </details>

          <a href={pageUrl(lang, 'acerca-de')} class="rounded-md px-3 py-2 text-[14px] text-fai-muted transition-colors hover:text-fai-ink">
            {t('nav.about')}
          </a>
        </nav>

        <div class="ml-auto flex items-center gap-2">
          <!-- Contador derivado del catálogo -->
          <a
            href={directory}
            class="fai-mono-sm hidden items-center rounded-full border border-[rgba(198,242,78,.4)] bg-[rgba(198,242,78,.12)] px-3 py-1.5 text-fai-find transition-colors hover:bg-[rgba(198,242,78,.2)] sm:inline-flex"
          >
            {verifiedCount} {t('home.verified-sources')}
          </a>

          <details class="relative" name="header-menus">
            <summary
              class="fai-mono-sm flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center gap-1.5 rounded-md border border-fai-line px-2.5 text-fai-muted transition-colors hover:text-fai-ink"
              aria-label={t('lang.change')}
            >
              {lang}
            </summary>
            <div class="absolute right-0 top-full z-50 mt-1 w-48 rounded-[14px] border border-fai-line bg-fai-surface p-1.5 shadow-2xl">
              {switcherLangs.map((option) => (
                <a
                  href={option.url}
                  hreflang={option.code}
                  aria-current={option.code === lang ? 'true' : undefined}
                  class="flex min-h-11 items-center rounded-md px-3 text-[14px] text-fai-ink transition-colors hover:bg-fai-card aria-[current]:text-fai-find"
                >{option.label}</a>
              ))}
            </div>
          </details>

          <details class="md:hidden" name="header-menus">
            <summary
              class="inline-flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-md border border-fai-line text-fai-muted transition-colors hover:text-fai-ink"
              aria-label={t('nav.open-menu')}
            >
              <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
              </svg>
            </summary>
            <nav
              class="absolute inset-x-0 top-16 z-50 max-h-[calc(100dvh-4rem)] overflow-y-auto border-b border-fai-line bg-fai-surface p-4 shadow-2xl"
              aria-label={t('nav.menu')}
            >
              <a href={directory} class="block rounded-md px-3 py-3 text-[15px] text-fai-ink hover:bg-fai-card">
                {t('nav.directory')}
              </a>
              <a href={hardware} class="block rounded-md px-3 py-3 text-[15px] text-fai-ink hover:bg-fai-card">
                {t('hw.nav')}
              </a>
              <p class="fai-mono-sm mt-4 px-3 py-1 text-fai-muted-2">{t('nav.categories')}</p>
              {CATEGORIES.map((cat) => (
                <a href={categoryUrl(lang, cat.slug)} class="block rounded-md px-3 py-3 text-[15px] text-fai-ink hover:bg-fai-card">
                  {cat.label[lang]}
                </a>
              ))}
              <p class="fai-mono-sm mt-4 px-3 py-1 text-fai-muted-2">{t('nav.legal')}</p>
              {legalLinks.map((link) => (
                <a href={link.href} class="block rounded-md px-3 py-3 text-[15px] text-fai-ink hover:bg-fai-card">{link.label}</a>
              ))}
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="contenido" class="mx-auto w-full max-w-[1240px] flex-1 px-5 pb-16">
      <slot />
    </main>

    <!-- PIE DE CONFIANZA -->
    <footer class="border-t border-fai-line bg-fai-surface/60">
      <div class="mx-auto grid max-w-[1240px] gap-8 px-5 py-12 sm:grid-cols-3">
        {trustColumns.map((column) => (
          <div>
            <h2 class="fai-mono-sm text-fai-signal">{column.title}</h2>
            <p class="mt-2.5 text-[14px] leading-[1.55] text-fai-muted sm:text-[13px]">{column.body}</p>
          </div>
        ))}
      </div>

      <div class="border-t border-fai-line">
        <div class="mx-auto flex max-w-[1240px] flex-wrap items-center gap-x-5 gap-y-3 px-5 py-5">
          <span class="text-[14px] font-bold tracking-[-0.02em] text-fai-ink">FuenteAI</span>
          <nav class="flex flex-wrap gap-x-4 gap-y-2" aria-label={t('nav.legal')}>
            {legalLinks.map((link) => (
              <a href={link.href} class="-mx-2 inline-flex min-h-11 items-center rounded-md px-2 text-[13px] text-fai-muted transition-colors hover:text-fai-signal sm:min-h-0">{link.label}</a>
            ))}
          </nav>
          <p class="w-full text-[12px] leading-[1.55] text-fai-muted-2 sm:w-auto sm:flex-1 sm:text-right">
            © {year} FuenteAI. {rightsLine}
          </p>
        </div>
      </div>
    </footer>

    <Motion />

    <script is:inline>
      // Cierra los menús <details> al hacer clic fuera o al pulsar Escape.
      const menus = Array.from(document.querySelectorAll('header details'));

      // Al tocar un enlace del menú móvil hay que cerrarlo: los enlaces de
      // ancla (#directorio) no recargan la página y el panel se quedaba
      // abierto tapando justo el contenido al que acababas de saltar.
      menus.forEach((menu) => {
        menu.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => {
            menu.open = false;
          });
        });
      });
      document.addEventListener('click', (event) => {
        menus.forEach((menu) => {
          if (menu.open && !menu.contains(event.target)) menu.open = false;
        });
      });
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        menus.forEach((menu) => {
          if (menu.open) {
            menu.open = false;
            menu.querySelector('summary')?.focus();
          }
        });
      });
    </script>
    <WebMcp lang={lang} />
  </body>
</html>
