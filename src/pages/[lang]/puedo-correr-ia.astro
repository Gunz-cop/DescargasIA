---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ModelTable from '../../components/hardware/ModelTable.astro';
import { languages, useTranslations } from '../../i18n/ui';
import { absolute, buildAlternates, hardwareUrl, homeUrl, pageUrl } from '../../utils/links';
import type { Lang } from '../../utils/brand';
import { EDITORIAL_TEAM } from '../../data/editorial-team';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang }
  }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const pagePath = hardwareUrl(lang);
const pageUrlAbsolute = absolute(Astro.url.origin, pagePath);
const alternates = buildAlternates(Astro.url.origin, (l) => hardwareUrl(l));
const description = t('hw.page.description');

const organization = {
  '@type': 'Organization',
  '@id': `${Astro.url.origin}/#editorial-team`,
  name: EDITORIAL_TEAM.name[lang],
  url: absolute(Astro.url.origin, pageUrl(lang, 'acerca-de'))
};

const faqItems = [
  {
    question: t('hw.page.faq.vram.question'),
    answer: t('hw.page.faq.vram.answer')
  },
  {
    question: t('hw.page.faq.context.question'),
    answer: t('hw.page.faq.context.answer')
  },
  {
    question: t('hw.page.faq.official.question'),
    answer: t('hw.page.faq.official.answer')
  }
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    '@id': `${pageUrlAbsolute}#application`,
    name: t('hw.page.title'),
    url: pageUrlAbsolute,
    description,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Windows, macOS, Linux',
    inLanguage: lang,
    author: { '@id': organization['@id'] },
    publisher: { '@id': organization['@id'] }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: t('nav.home'),
        item: absolute(Astro.url.origin, homeUrl(lang))
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: t('hw.page.title'),
        item: pageUrlAbsolute
      }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map(({ question, answer }) => ({
      '@type': 'Question',
      name: question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: answer
      }
    }))
  },
  organization
];

const methodology = {
  weights: lang === 'sv'
    ? 'Minnesvärdet utgår från den publicerade storleken på vikterna i varje GGUF-fil. Därefter läggs KV-cachen, som växer med kontextlängden, och en marginal för runtime och aktiveringar till.'
    : lang === 'it'
      ? 'La memoria parte dalla dimensione pubblicata dei pesi di ogni file GGUF. Poi si aggiungono la cache KV, che cresce con la lunghezza del contesto, e un margine per runtime e attivazioni.'
      : 'La memoria parte del tamaño publicado de los pesos de cada archivo GGUF. Después se suma la caché KV, que crece con la longitud del contexto, y un margen para el runtime y las activaciones.',
  speed: lang === 'sv'
    ? 'Hastigheten är alltid en uppskattning: den beror på minnesbandbredd, processor, backend och inställningar. Den interaktiva motorn räknar senare ut ett besked utifrån dina uppgifter.'
    : lang === 'it'
      ? 'La velocità è sempre una stima: dipende da banda di memoria, processore, backend e configurazione. Il motore interattivo calcolerà poi il verdetto usando i tuoi dati.'
      : 'La velocidad siempre será una estimación: depende del ancho de banda, del procesador, del backend y de la configuración. El motor interactivo calculará después el veredicto con tus datos.'
};
---

<BaseLayout
  title={t('hw.page.title')}
  description={description}
  lang={lang}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <article class="hardware-page mx-auto max-w-5xl py-10 sm:py-14" aria-labelledby="hardware-page-title">
    <header class="max-w-3xl border-b border-fai-line pb-8">
      <span class="fai-mono-sm inline-flex rounded border border-fai-signal/30 bg-fai-signal/10 px-3 py-1 text-fai-signal">
        {t('hw.page.eyebrow')}
      </span>
      <h1 id="hardware-page-title" class="mt-4 text-[32px] font-semibold leading-[1.08] tracking-[-0.03em] text-fai-ink sm:text-[48px]">
        {t('hw.page.title')}
      </h1>
      <p class="mt-5 text-[16px] leading-7 text-fai-ink-2">{t('hw.page.form.description')}</p>
    </header>

    <section id="hardware-app" class="mt-8 min-w-0 space-y-10" data-hardware-app aria-labelledby="hardware-app-title">
      <div class="rounded-2xl border border-fai-line bg-fai-surface p-5 sm:p-7">
        <div class="max-w-2xl">
          <h2 id="hardware-app-title" class="text-[22px] font-semibold tracking-[-0.02em] text-fai-ink sm:text-[26px]">
            {t('hw.step1.title')}
          </h2>
          <p class="mt-2 text-[15px] leading-7 text-fai-muted">{t('hw.page.form.description')}</p>
        </div>

        <form action={pagePath} method="get" class="mt-6 grid min-w-0 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <label class="grid min-w-0 gap-2 sm:col-span-2 lg:col-span-3">
            <span class="text-[14px] font-medium text-fai-ink">{t('hw.step1.free-label')}</span>
            <input
              name="gpu"
              type="text"
              placeholder={t('hw.step1.free-placeholder')}
              class="min-h-11 min-w-0 rounded-lg border border-fai-line bg-fai-card px-3 text-[15px] text-fai-ink placeholder:text-fai-muted-2 focus:border-fai-signal focus:outline-none focus:ring-2 focus:ring-fai-signal/30"
            />
          </label>
          <label class="grid min-w-0 gap-2">
            <span class="text-[14px] font-medium text-fai-ink">{t('hw.field.vram')}</span>
            <input name="vram" type="number" min="1" step="1" inputmode="numeric" placeholder="8" class="min-h-11 min-w-0 rounded-lg border border-fai-line bg-fai-card px-3 text-[15px] text-fai-ink placeholder:text-fai-muted-2 focus:border-fai-signal focus:outline-none focus:ring-2 focus:ring-fai-signal/30" />
          </label>
          <label class="grid min-w-0 gap-2">
            <span class="text-[14px] font-medium text-fai-ink">{t('hw.field.ram')}</span>
            <input name="ram" type="number" min="1" step="1" inputmode="numeric" placeholder="16" class="min-h-11 min-w-0 rounded-lg border border-fai-line bg-fai-card px-3 text-[15px] text-fai-ink placeholder:text-fai-muted-2 focus:border-fai-signal focus:outline-none focus:ring-2 focus:ring-fai-signal/30" />
          </label>
          <label class="grid min-w-0 gap-2">
            <span class="text-[14px] font-medium text-fai-ink">{t('hw.page.form.context')}</span>
            <select name="ctx" class="min-h-11 min-w-0 rounded-lg border border-fai-line bg-fai-card px-3 text-[15px] text-fai-ink focus:border-fai-signal focus:outline-none focus:ring-2 focus:ring-fai-signal/30">
              <option value="4096">{t('hw.page.form.context.4k')}</option>
              <option value="8192">{t('hw.page.form.context.8k')}</option>
              <option value="32768">{t('hw.page.form.context.32k')}</option>
            </select>
          </label>
          <label class="grid min-w-0 gap-2">
            <span class="text-[14px] font-medium text-fai-ink">{t('hw.field.os')}</span>
            <select name="os" class="min-h-11 min-w-0 rounded-lg border border-fai-line bg-fai-card px-3 text-[15px] text-fai-ink focus:border-fai-signal focus:outline-none focus:ring-2 focus:ring-fai-signal/30">
              <option value="">{t('hw.page.form.os.any')}</option>
              <option value="windows">Windows</option>
              <option value="macos">macOS</option>
              <option value="linux">Linux</option>
            </select>
          </label>
          <div class="flex items-end">
            <button type="submit" class="min-h-11 w-full rounded-lg bg-fai-find px-4 py-2.5 text-[15px] font-semibold text-[#04120e] transition-colors hover:bg-fai-ink focus:outline-none focus:ring-2 focus:ring-fai-find/50">
              {t('hw.page.form.submit')}
            </button>
          </div>
        </form>
        <p class="mt-4 text-[13px] leading-6 text-fai-muted-2">{t('hw.privacy')}</p>
      </div>

      <ModelTable lang={lang} />
    </section>

    <section class="mt-12 grid gap-8 border-t border-fai-line pt-10 lg:grid-cols-[1fr_18rem]" aria-labelledby="methodology-title">
      <div>
        <h2 id="methodology-title" class="text-[24px] font-semibold tracking-[-0.02em] text-fai-ink sm:text-[28px]">
          {t('hw.page.methodology.title')}
        </h2>
        <div class="mt-4 space-y-4 text-[15px] leading-7 text-fai-muted">
          <p>{methodology.weights}</p>
          <p>{methodology.speed}</p>
        </div>
      </div>
      <aside class="rounded-2xl border border-fai-line bg-fai-surface p-5">
        <p class="fai-mono-sm text-fai-signal">{t('hw.estimate-notice')}</p>
        <p class="mt-3 text-[14px] leading-6 text-fai-muted">{t('hw.table.memory-note')}</p>
      </aside>
    </section>

    <section class="mt-12 border-t border-fai-line pt-10" aria-labelledby="faq-title">
      <h2 id="faq-title" class="text-[24px] font-semibold tracking-[-0.02em] text-fai-ink sm:text-[28px]">{t('hw.page.faq.title')}</h2>
      <div class="mt-5 grid gap-4 md:grid-cols-3">
        {faqItems.map((item) => (
          <details class="rounded-2xl border border-fai-line bg-fai-surface p-5">
            <summary class="cursor-pointer text-[15px] font-medium leading-6 text-fai-ink">{item.question}</summary>
            <p class="mt-3 text-[14px] leading-6 text-fai-muted">{item.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .hardware-page {
    min-width: 0;
    overflow-x: clip;
  }
</style>
