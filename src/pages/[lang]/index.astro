---
// src/pages/[lang]/index.astro
import { languages } from '../../i18n/ui';
import Home from '../../components/Home.astro';
import { ROOT_LANG } from '../../utils/links';

export async function getStaticPaths() {
  // "es" queda fuera a proposito: la portada en espanol es "/" (src/pages/index.astro).
  // Generar tambien "/es" creaba un duplicado que se llevaba TODOS los enlaces
  // internos mientras el canonical apuntaba a "/". Ver docs/enlazado-interno.md.
  return Object.keys(languages)
    .filter((lang) => lang !== ROOT_LANG)
    .map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: 'sv' | 'it' };
---
<Home lang={lang} />
