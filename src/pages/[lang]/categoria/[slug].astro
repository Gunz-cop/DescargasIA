---
// src/pages/[lang]/categoria/[slug].astro
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ToolCard from '../../../components/ToolCard.astro';
import CategoryNav from '../../../components/CategoryNav.astro';
import { getTranslatedTools } from '../../../utils/tools';
import { useTranslations, languages } from '../../../i18n/ui';
import { getCategory, getCategoryLabel, type Lang } from '../../../utils/brand';

export async function getStaticPaths() {
  const locales = Object.keys(languages);
  const categories = await getCollection('categories');
  const paths = [];

  for (const lang of locales) {
    for (const cat of categories) {
      paths.push({
        params: { lang, slug: cat.data.slug },
        props: { cat, lang }
      });
    }
  }

  return paths;
}

const { cat, lang } = Astro.props as { cat: any; lang: Lang };
const t = useTranslations(lang);

const allTools = await getTranslatedTools(lang);
const tools = allTools.filter((tool) => tool.categories.includes(cat.data.slug));

const trustPriority = { official: 3, verified: 2, 'pending-review': 1 } as const;
const sortedTools = [...tools].sort((a, b) => {
  const diff = (trustPriority[b.trustLevel] ?? 0) - (trustPriority[a.trustLevel] ?? 0);
  return diff !== 0 ? diff : a.name.localeCompare(b.name, lang);
});

const meta = getCategory(cat.data.slug);
const localizedCatName = getCategoryLabel(cat.data.slug, lang);
const tone = meta?.tone ?? '#a63d1e';
const countLabel = sortedTools.length === 1 ? t('directory.count.one') : t('directory.count.other');

const pageTitle = lang === 'sv'
  ? `AI-verktyg inom ${localizedCatName} | FuenteAI`
  : lang === 'it'
    ? `Strumenti IA in ${localizedCatName} | FuenteAI`
    : `Descargas de herramientas en ${localizedCatName} | FuenteAI`;

const pageDesc = lang === 'sv'
  ? `Officiella nedladdningslänkar för ${localizedCatName}. Verifierade och säkra källor.`
  : lang === 'it'
    ? `Collegamenti ufficiali di download per ${localizedCatName}. Fonti verificate e sicure.`
    : `${cat.data.description} Enlaces de descarga oficiales y verificados de forma segura en FuenteAI.`;

const schemaBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t('nav.home'),
      item: `${Astro.url.origin}/${lang}`
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: localizedCatName,
      item: Astro.url.href
    }
  ]
};

const schemaItemList = sortedTools.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: localizedCatName,
  numberOfItems: sortedTools.length,
  itemListElement: sortedTools.map((tool, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: `${Astro.url.origin}/${lang}/${tool.slug}`,
    name: tool.name
  }))
} : null;

const alternates = Object.keys(languages)
  .filter((l) => l !== 'it')
  .map((l) => ({
    lang: l,
    url: `${Astro.url.origin}/${l}/categoria/${cat.data.slug}`
  }));
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  jsonLd={schemaItemList ? [schemaBreadcrumb, schemaItemList] : schemaBreadcrumb}
  lang={lang}
  alternates={alternates}
>
  <nav class="flex flex-wrap items-center gap-2 pt-6 text-[13px] text-brand-text-muted" aria-label="Breadcrumb">
    <a href={`/${lang}`} class="transition-colors hover:text-brand-text">{t('nav.home')}</a>
    <span class="text-brand-text-subtle" aria-hidden="true">/</span>
    <span class="text-brand-text" aria-current="page">{localizedCatName}</span>
  </nav>

  <header class="mt-6 border-b border-brand-hairline pb-8">
    <p class="eyebrow flex items-center gap-2" style={`color:${tone}`}>
      <span class="h-2 w-2 rounded-full" style={`background:${tone}`} aria-hidden="true"></span>
      {t('nav.categories')}
    </p>
    <h1 class="display mt-4 text-[40px] sm:text-[54px]">{localizedCatName}</h1>
    <p class="mt-4 max-w-2xl text-[15px] leading-7 text-brand-text-muted">{cat.data.description}</p>
    <p class="data-tag mt-4 text-brand-text-subtle">{sortedTools.length} {countLabel}</p>
  </header>

  {sortedTools.length > 0 ? (
    <div class="tools mt-8" data-view="grid">
      {sortedTools.map((tool, index) => <ToolCard tool={tool} index={index + 1} />)}
    </div>
  ) : (
    <div class="mt-8 rounded-lg border border-dashed border-brand-card-border bg-brand-surface-sunken px-6 py-16 text-center">
      <h2 class="display text-[22px]">{t('category.empty.title')}</h2>
      <p class="mx-auto mt-2 max-w-md text-[14px] leading-6 text-brand-text-muted">{t('category.empty.body')}</p>
      <a
        href={`/${lang}`}
        class="mt-6 inline-flex min-h-11 items-center rounded-md bg-brand-primary px-4 text-[13px] font-semibold text-brand-on-primary transition-colors hover:bg-brand-primary-hover"
      >{t('category.back')}</a>
    </div>
  )}

  <section class="mt-16 border-t border-brand-hairline pt-10" aria-labelledby="otras-categorias">
    <h2 id="otras-categorias" class="display text-[28px]">{t('home.categories.title')}</h2>
    <div class="mt-5">
      <CategoryNav lang={lang} tools={allTools} current={cat.data.slug} />
    </div>
  </section>
</BaseLayout>
