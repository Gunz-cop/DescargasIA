---
// src/pages/[lang]/categoria/[slug].astro — necesidad (dirección 1a)
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ToolCard from '../../../components/ToolCard.astro';
import { getTranslatedTools } from '../../../utils/tools';
import { useTranslations, languages } from '../../../i18n/ui';
import { CATEGORIES, getCategoryLabel, type Lang } from '../../../utils/brand';

export async function getStaticPaths() {
  const locales = Object.keys(languages);
  const categories = await getCollection('categories');
  const paths = [];

  for (const lang of locales) {
    for (const cat of categories) {
      paths.push({ params: { lang, slug: cat.data.slug }, props: { cat, lang } });
    }
  }

  return paths;
}

const { cat, lang } = Astro.props as { cat: any; lang: Lang };
const t = useTranslations(lang);

const allTools = await getTranslatedTools(lang);
const tools = allTools.filter((tool) => tool.categories.includes(cat.data.slug));

const trustPriority = { official: 3, verified: 2, 'pending-review': 1 } as const;
const sortedTools = [...tools].sort((a, b) => {
  const diff = (trustPriority[b.trustLevel] ?? 0) - (trustPriority[a.trustLevel] ?? 0);
  return diff !== 0 ? diff : a.name.localeCompare(b.name, lang);
});

const localizedCatName = getCategoryLabel(cat.data.slug, lang);

// Conteos de las demás necesidades, derivados del catálogo.
const otherNeeds = CATEGORIES.map((need) => ({
  ...need,
  count: allTools.filter((tool) => tool.categories.includes(need.slug)).length
})).filter((need) => need.count > 0 || need.slug === cat.data.slug);

const KNOWN_BASELINE = 2;

const pageTitle = lang === 'sv'
  ? `${sortedTools.length} officiella AI-verktyg för ${localizedCatName} | FuenteAI`
  : lang === 'it'
    ? `${sortedTools.length} strumenti IA ufficiali per ${localizedCatName} | FuenteAI`
    : `${sortedTools.length} herramientas de IA oficiales para ${localizedCatName} | FuenteAI`;

const pageDesc = lang === 'sv'
  ? `Officiella nedladdningslänkar för ${localizedCatName}. Verifierade och säkra källor.`
  : lang === 'it'
    ? `Collegamenti ufficiali di download per ${localizedCatName}. Fonti verificate e sicure.`
    : `${cat.data.description} Enlaces de descarga oficiales y verificados en FuenteAI.`;

const schemaBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('nav.home'), item: `${Astro.url.origin}/${lang}` },
    { '@type': 'ListItem', position: 2, name: localizedCatName, item: Astro.url.href }
  ]
};

const schemaItemList = sortedTools.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: localizedCatName,
  numberOfItems: sortedTools.length,
  itemListElement: sortedTools.map((tool, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: `${Astro.url.origin}/${lang}/${tool.slug}`,
    name: tool.name
  }))
} : null;

const alternates = Object.keys(languages)
  .filter((l) => l !== 'it')
  .map((l) => ({ lang: l, url: `${Astro.url.origin}/${l}/categoria/${cat.data.slug}` }));
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  jsonLd={schemaItemList ? [schemaBreadcrumb, schemaItemList] : schemaBreadcrumb}
  lang={lang}
  alternates={alternates}
>
  <nav class="fai-mono-sm flex flex-wrap items-center gap-2 pt-7 text-fai-muted-2" aria-label="Breadcrumb">
    <a href={`/${lang}`} class="transition-colors hover:text-fai-signal">FuenteAI</a>
    <span aria-hidden="true">/</span>
    <span class="text-fai-muted" aria-current="page">{localizedCatName}</span>
  </nav>

  <!-- Chips de necesidad: la activa en lima -->
  <div class="mt-8 flex flex-wrap gap-2.5">
    {otherNeeds.map((need) => (
      <a
        href={`/${lang}/categoria/${need.slug}`}
        class="fai-chip"
        aria-current={need.slug === cat.data.slug ? 'page' : undefined}
      >
        {need.short[lang]}
        <span class="fai-chip__count">{need.count}</span>
      </a>
    ))}
  </div>

  <!-- §6 CountHeadline -->
  <header class="mt-12 border-t border-fai-line pt-7">
    <h1 class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <span class="fai-count" data-count-to={sortedTools.length} data-count-from={KNOWN_BASELINE}>
        {sortedTools.length}
      </span>
      <span class="fai-section-title text-fai-ink">{t('count.for')} {localizedCatName.toLowerCase()}</span>
    </h1>
    {sortedTools.length > KNOWN_BASELINE && (
      <p class="fai-mono-sm mt-2.5 text-fai-muted-2">
        {t('count.most-know')} {sortedTools.length - KNOWN_BASELINE}
      </p>
    )}
    <p class="mt-5 max-w-[62ch] text-[15px] leading-[1.55] text-fai-muted">{cat.data.description}</p>
  </header>

  {sortedTools.length > 0 ? (
    <div class="fai-grid mt-8">
      {sortedTools.map((tool, index) => <ToolCard tool={tool} index={index} />)}
    </div>
  ) : (
    <div class="mt-8 rounded-[14px] border border-dashed border-fai-line px-6 py-16 text-center">
      <p class="fai-section-title text-fai-ink">{t('category.empty.title')}</p>
      <p class="mx-auto mt-2.5 max-w-md text-[14px] leading-[1.55] text-fai-muted">{t('category.empty.body')}</p>
      <a href={`/${lang}`} class="fai-chip mt-6 !bg-fai-find !border-fai-find !text-[#06231c] font-semibold">
        {t('category.back')}
      </a>
    </div>
  )}
</BaseLayout>
