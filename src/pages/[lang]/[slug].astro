---
// src/pages/[lang]/[slug].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Monogram from '../../components/Monogram.astro';
import { getTranslatedTools, getTranslatedTool } from '../../utils/tools';
import { useTranslations, languages } from '../../i18n/ui';
import {
  formatDate,
  getCategoryLabel,
  getCategory,
  getDomain,
  getInitials,
  getToolTone,
  PLATFORM_ORDER,
  type Lang
} from '../../utils/brand';

export async function getStaticPaths() {
  const locales = Object.keys(languages);
  const paths = [];

  for (const lang of locales) {
    const tools = await getTranslatedTools(lang);
    for (const tool of tools) {
      paths.push({
        params: { lang, slug: tool.slug },
        props: { tool, lang }
      });
    }
  }

  return paths;
}

const { tool, lang } = Astro.props as { tool: any; lang: Lang };
const t = useTranslations(lang);

const allTools = await getTranslatedTools(lang);
const toolsBySlug = new Map(allTools.map((entry) => [entry.slug, entry]));

const pricingLabels = {
  free: t('info.pricing.free'),
  freemium: t('info.pricing.freemium'),
  paid: t('info.pricing.paid'),
  enterprise: t('info.pricing.enterprise'),
  unknown: t('info.pricing.unknown')
};
const pricingLabel = pricingLabels[tool.pricingModel as keyof typeof pricingLabels] ?? pricingLabels.unknown;

const languageSupport = {
  es: tool.spanishSupport,
  sv: tool.swedishSupport,
  it: tool.italianSupport
}[lang];

const languageLabels = {
  es: {
    yes: t('info.spanish.yes'),
    partial: t('info.spanish.partial'),
    no: t('info.spanish.no'),
    unknown: t('info.spanish.unknown')
  },
  sv: {
    yes: t('info.swedish.yes'),
    partial: t('info.swedish.partial'),
    no: t('info.swedish.no'),
    unknown: t('info.swedish.unknown')
  },
  it: {
    yes: t('info.italian.yes'),
    partial: t('info.italian.partial'),
    no: t('info.italian.no'),
    unknown: t('info.italian.unknown')
  }
}[lang];

const languageLabel = languageLabels[(languageSupport as keyof typeof languageLabels) ?? 'unknown'] ?? languageLabels.unknown;

const trustLabels = {
  official: t('info.trust.official'),
  verified: t('info.trust.verified'),
  'pending-review': t('info.trust.pending-review')
};
const trustLabel = trustLabels[tool.trustLevel as keyof typeof trustLabels] ?? trustLabels['pending-review'];

const accountLabel = tool.requiresAccount === true
  ? t('info.account.required')
  : tool.requiresAccount === false
    ? t('info.account.optional')
    : t('info.account.unknown');

const platformNames: Record<string, string> = {
  web: t('platform.web'),
  windows: t('platform.windows'),
  mac: t('platform.mac'),
  linux: t('platform.linux'),
  android: t('platform.android'),
  ios: t('platform.ios')
};

const platformTypeLabels: Record<string, string> = {
  'official-site': t('platform.type.official-site'),
  'app-store': t('platform.type.app-store'),
  'web-app': t('platform.type.web-app'),
  documentation: t('platform.type.documentation'),
  'official-installer': t('platform.type.official-installer'),
  'github-repo': t('platform.type.github-repo'),
  'package-manager': t('platform.type.package-manager')
};

const platformBtnLabels: Record<string, string> = {
  'official-site': t('platform.btn.official-site'),
  'app-store': t('platform.btn.app-store'),
  'web-app': t('platform.btn.web-app'),
  documentation: t('platform.btn.documentation'),
  'official-installer': t('platform.btn.official-installer'),
  'github-repo': t('platform.btn.github-repo'),
  'package-manager': t('platform.btn.package-manager')
};

const platforms = PLATFORM_ORDER
  .filter((key) => Boolean(tool.platforms[key]))
  .map((key) => {
    const details = tool.platforms[key] as any;
    return {
      id: key,
      name: platformNames[key] ?? key,
      url: details.url,
      type: details.type,
      lastChecked: details.lastChecked,
      typeLabel: platformTypeLabels[details.type] ?? details.type,
      btnLabel: platformBtnLabels[details.type] ?? t('card.cta'),
      host: getDomain(details.url)
    };
  });

const primaryPlatform = platforms.find((item) => item.id === 'web') ?? platforms[0];
const primaryCta = primaryPlatform
  ? `/r/?t=${tool.slug}&p=${primaryPlatform.id}&l=${lang}`
  : `/r/?t=${tool.slug}&l=${lang}`;

const officialDomain = getDomain(tool.officialWebsite);
const tone = getToolTone(tool.slug, tool.categories);
const initials = getInitials(tool.name, tool.initials);
const primaryCategorySlug = tool.categories[0] ?? '';
const primaryCategory = getCategory(primaryCategorySlug);
const categoryLabel = getCategoryLabel(primaryCategorySlug, lang);
const reviewDateLong = formatDate(tool.lastReviewed, lang, true);
const reviewDateShort = formatDate(tool.lastReviewed, lang);

const bestFor = tool.bestFor.length > 0
  ? tool.bestFor
  : tool.tags.slice(0, 4).map((tag: string) =>
      lang === 'sv'
        ? `Användare som söker efter ${tag}`
        : lang === 'it'
          ? `Utenti che cercano ${tag}`
          : `Usuarios que buscan ${tag.replaceAll('-', ' ')}`
    );

const editorialSummary = tool.editorialSummary ?? tool.longDescription;
const alternatives = tool.alternatives
  .map((slug: string) => toolsBySlug.get(slug))
  .filter(Boolean);

// Sólo se declara imagen cuando existe una captura oficial aprobada.
// (Antes se emitía un SVG generado como data-URI: ni los buscadores ni las
// redes sociales pueden recuperarlo, así que sólo añadía peso al HTML.)
const toolImage: string | undefined = tool.screenshotUrl ?? undefined;

const schemaApp = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: tool.name,
  description: tool.shortDescription,
  applicationCategory: 'OtherApplication',
  applicationSubCategory: 'Artificial Intelligence',
  operatingSystem: platforms.map((platform) => platform.name).join(', '),
  url: Astro.url.href,
  dateModified: tool.lastReviewed,
  ...(toolImage ? { image: toolImage } : {}),
  sameAs: tool.officialSources,
  offers: {
    '@type': 'Offer',
    price: tool.pricingModel === 'free' ? '0' : undefined,
    priceCurrency: tool.pricingModel === 'free' ? 'USD' : undefined
  }
};

const schemaBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t('nav.home'),
      item: `${Astro.url.origin}/${lang}`
    },
    ...(primaryCategory
      ? [{
          '@type': 'ListItem',
          position: 2,
          name: categoryLabel,
          item: `${Astro.url.origin}/${lang}/categoria/${primaryCategory.slug}`
        }]
      : []),
    {
      '@type': 'ListItem',
      position: primaryCategory ? 3 : 2,
      name: tool.name,
      item: Astro.url.href
    }
  ]
};

const schemaFaq = tool.faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: tool.faq.map((item: { question: string; answer: string }) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer }
  }))
} : null;

const jsonLd = schemaFaq ? [schemaApp, schemaBreadcrumb, schemaFaq] : [schemaApp, schemaBreadcrumb];

const alternatePromises = Object.keys(languages).map(async (l) => {
  const exists = await getTranslatedTool(l, tool.slug);
  return exists ? { lang: l, url: `${Astro.url.origin}/${l}/${tool.slug}` } : null;
});
const resolvedAlternates = (await Promise.all(alternatePromises)).filter(Boolean) as Array<{ lang: string; url: string }>;

const docTitle = lang === 'sv'
  ? `Ladda ner ${tool.name} officiell och säker | FuenteAI`
  : lang === 'it'
    ? `Come scaricare ${tool.name} ufficiale e sicuro | FuenteAI`
    : `Dónde descargar ${tool.name} oficial y seguro | FuenteAI`;

const docDesc = lang === 'sv'
  ? `Hitta officiella länkar för ${tool.name}. Läs om kompatibilitet, priser, kontokrav och säker granskning.`
  : lang === 'it'
    ? `Trova i canali ufficiali per ${tool.name}. Controlla compatibilità, prezzi, requisiti dell'account e recensioni.`
    : `Ficha editorial para encontrar los canales oficiales de ${tool.name}, revisar compatibilidad, advertencias de seguridad y alternativas similares.`;

const h1 = lang === 'sv'
  ? `Ladda ner ${tool.name} officiell`
  : lang === 'it'
    ? `Scaricare ${tool.name} ufficiale`
    : `Descargar ${tool.name} oficial`;

const quickFacts = [
  { label: t('tool.price'), value: pricingLabel },
  { label: t('tool.account'), value: accountLabel },
  { label: t('tool.language'), value: languageLabel },
  { label: t('tool.trust'), value: trustLabel },
  { label: t('tool.platforms.count'), value: String(platforms.length) }
];

const slugify = (value: string) =>
  value.toLowerCase().replace(new RegExp('[^a-z0-9]+', 'g'), '-').replace(new RegExp('(^-|-$)', 'g'), '');
---

<BaseLayout
  title={docTitle}
  description={docDesc}
  jsonLd={jsonLd}
  lang={lang}
  alternates={resolvedAlternates}
  ogImage={toolImage}
>
  <!-- Migas -->
  <nav class="flex flex-wrap items-center gap-2 pt-6 text-[13px] text-brand-text-muted" aria-label="Breadcrumb">
    <a href={`/${lang}`} class="transition-colors hover:text-brand-text">{t('nav.home')}</a>
    <span class="text-brand-text-subtle" aria-hidden="true">/</span>
    {primaryCategory && (
      <>
        <a href={`/${lang}/categoria/${primaryCategory.slug}`} class="transition-colors hover:text-brand-text">{categoryLabel}</a>
        <span class="text-brand-text-subtle" aria-hidden="true">/</span>
      </>
    )}
    <span class="text-brand-text" aria-current="page">{tool.name}</span>
  </nav>

  <!-- CABECERA DE FICHA -->
  <header class="mt-5 border-b border-brand-hairline pb-10">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-start">
      <div class="min-w-0">
        <div class="flex items-center gap-4">
          <Monogram initials={initials} tone={tone} size="lg" />
          <p class="flex flex-col gap-1 text-[13px] text-brand-text-muted">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-md border border-brand-success-border bg-brand-success-bg px-2 py-0.5 font-medium text-brand-success">
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20 6 9 17l-5-5" />
              </svg>
              {trustLabel}
            </span>
            <span>{categoryLabel} · {pricingLabel}</span>
          </p>
        </div>

        <h1 class="display mt-5 max-w-[16ch] text-[38px] sm:text-[52px]">{h1}</h1>

        <p class="mt-5 max-w-2xl border-l-2 border-brand-primary pl-4 text-[16px] leading-7 text-brand-text-muted">
          {tool.shortDescription}
        </p>
      </div>

      <!-- Sello de verificación: el elemento firma de la ficha.
           Declara lo que comprobamos nosotros, no un aval de la marca. -->
      <div class="flex shrink-0 justify-start lg:justify-end lg:pt-2">
        <p class="stamp">
          <span class="stamp__label block">{t('tool.verified-origin')}</span>
          <span class="stamp__value mt-1.5 block">{officialDomain}</span>
          <span class="stamp__meta mt-1.5 block">
            {reviewDateShort ? `rev. ${reviewDateShort}` : `${platforms.length} ${t('tool.platforms.count')}`}
          </span>
        </p>
      </div>
    </div>

    <div class="mt-9 grid gap-4 lg:grid-cols-[1fr_auto] lg:items-end">
      <dl class="grid gap-px overflow-hidden rounded-lg border border-brand-card-border bg-brand-card-border sm:grid-cols-3">
        <div class="bg-brand-surface px-4 py-3.5">
          <dt class="eyebrow text-brand-text-subtle">{t('tool.platforms.count')}</dt>
          <dd class="mt-1.5 text-[14px] font-semibold text-brand-text">{platforms.length}</dd>
        </div>
        <div class="bg-brand-surface px-4 py-3.5">
          <dt class="eyebrow text-brand-text-subtle">{t('tool.account')}</dt>
          <dd class="mt-1.5 text-[14px] font-semibold text-brand-text">{accountLabel}</dd>
        </div>
        <div class="bg-brand-surface px-4 py-3.5">
          <dt class="eyebrow text-brand-text-subtle">{t('info.reviewed-on')}</dt>
          <dd class="mt-1.5 text-[14px] font-semibold text-brand-text">{reviewDateLong ?? '—'}</dd>
        </div>
      </dl>

      <div class="flex flex-col gap-2.5 sm:flex-row lg:justify-end">
        <a
          href={primaryCta}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-12 items-center justify-center gap-2 rounded-md bg-brand-primary px-5 text-[14px] font-semibold text-brand-on-primary transition-colors hover:bg-brand-primary-hover"
        >
          {t('tool.cta.primary')}
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7m0 0h-7m7 0v7" />
          </svg>
        </a>
        <a
          href="#compatibilidad"
          class="inline-flex min-h-12 items-center justify-center rounded-md border border-brand-card-border bg-brand-surface px-5 text-[14px] font-medium text-brand-text transition-colors hover:border-brand-text/30 hover:bg-brand-surface-sunken"
        >
          {t('tool.cta.secondary')}
        </a>
      </div>
    </div>
  </header>

  <div class="mt-10 grid gap-10 lg:grid-cols-[1fr_19rem] lg:gap-12">
    <div class="flex min-w-0 flex-col gap-12">
      <!-- Canales oficiales -->
      <section id="compatibilidad" class="scroll-mt-24" aria-labelledby="descargas-title">
        <div class="mb-5 flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="eyebrow text-brand-primary">{t('tool.platforms.eyebrow')}</p>
            <h2 id="descargas-title" class="display mt-1.5 text-[30px]">{t('tool.platforms.title')}</h2>
          </div>
          <p class="text-[13px] text-brand-text-subtle">{t('tool.platforms.note')}</p>
        </div>

        <ul class="grid gap-px overflow-hidden rounded-lg border border-brand-card-border bg-brand-card-border" role="list">
          {platforms.map(({ id, name, typeLabel, host, lastChecked, btnLabel }) => (
            <li class="flex flex-col gap-3 bg-brand-surface p-4 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
              <div class="min-w-0">
                <h3 class="text-[15px] font-semibold text-brand-text">{name}</h3>
                <p class="mt-0.5 text-[13px] text-brand-text-muted">{typeLabel}</p>
                <p class="data-tag mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-brand-text-subtle">
                  <span class="text-brand-success">{host}</span>
                  {lastChecked && formatDate(lastChecked, lang) && (
                    <>
                      <span aria-hidden="true">·</span>
                      <span>rev. {formatDate(lastChecked, lang)}</span>
                    </>
                  )}
                </p>
              </div>
              <a
                href={`/r/?t=${tool.slug}&p=${id}&l=${lang}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-11 shrink-0 items-center justify-center gap-1.5 rounded-md border border-brand-primary/40 bg-brand-primary-soft px-4 text-[13px] font-semibold text-brand-primary transition-colors hover:bg-brand-primary hover:text-brand-on-primary"
              >
                {btnLabel}
                <span class="sr-only">— {name}</span>
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7m0 0h-7m7 0v7" />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <!-- Para qué sirve mejor -->
      <section aria-labelledby="mejor-para-title">
        <h2 id="mejor-para-title" class="display text-[30px]">
          {t('section.best-for')} {tool.name}
        </h2>
        <ul class="mt-5 grid gap-3 sm:grid-cols-2" role="list">
          {bestFor.map((item: string) => (
            <li class="flex gap-2.5 rounded-lg border border-brand-card-border bg-brand-surface p-4">
              <svg class="mt-0.5 h-4 w-4 shrink-0 text-brand-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20 6 9 17l-5-5" />
              </svg>
              <span class="text-[14px] leading-6 text-brand-text">{item}</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- Resumen editorial -->
      <section aria-labelledby="resumen-title">
        <h2 id="resumen-title" class="display text-[30px]">
          {lang === 'sv'
            ? `Vad du bör veta om ${tool.name}`
            : lang === 'it'
              ? `Cosa dovresti sapere prima di usare ${tool.name}`
              : `Qué debes saber antes de usar ${tool.name}`}
        </h2>
        <p class="mt-4 max-w-[68ch] text-[15px] leading-7 text-brand-text-muted">{editorialSummary}</p>
      </section>

      {tool.editorialSections.length > 0 && (
        <section aria-labelledby="guia-title">
          <p class="eyebrow text-brand-primary">
            {lang === 'sv' ? 'Redaktionell granskning' : lang === 'it' ? 'Guida editoriale' : 'Guía editorial'}
          </p>
          <h2 id="guia-title" class="display mt-1.5 text-[30px]">
            {lang === 'sv'
              ? `Guide till ${tool.name} utan spegelsajter`
              : lang === 'it'
                ? `Guida all'uso di ${tool.name} in sicurezza`
                : `Guía completa para usar ${tool.name} sin caer en descargas falsas`}
          </h2>
          <div class="mt-6 flex flex-col gap-8">
            {tool.editorialSections.map((section: { heading: string; body: string }) => (
              <section aria-labelledby={`${tool.slug}-${slugify(section.heading)}`}>
                <h3 id={`${tool.slug}-${slugify(section.heading)}`} class="display text-[22px]">
                  {section.heading}
                </h3>
                <div class="mt-3 flex max-w-[68ch] flex-col gap-3 text-[15px] leading-7 text-brand-text-muted">
                  {section.body.split('\n\n').map((paragraph: string) => (
                    <p>{paragraph}</p>
                  ))}
                </div>
              </section>
            ))}
          </div>
        </section>
      )}

      {tool.safetyNotes.length > 0 && (
        <section class="rounded-lg border border-brand-warning-border bg-brand-warning-bg p-5 sm:p-6" aria-labelledby="seguridad-title">
          <p class="eyebrow text-brand-warning-text">{t('section.safety')}</p>
          <h2 id="seguridad-title" class="display mt-1.5 text-[26px]">
            {lang === 'sv'
              ? 'Undvik spegelsajter och skadliga filer'
              : lang === 'it'
                ? 'Evita cloni e falsi download'
                : 'Evita clones y descargas falsas'}
          </h2>
          <ul class="mt-4 flex flex-col gap-2.5" role="list">
            {tool.safetyNotes.map((note: string) => (
              <li class="flex gap-2.5 text-[14px] leading-6 text-brand-text">
                <svg class="mt-1 h-3.5 w-3.5 shrink-0 text-brand-warning-text" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2 1.5 21h21L12 2Zm0 6 .9 7h-1.8L12 8Zm0 9.6a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4Z" />
                </svg>
                {note}
              </li>
            ))}
          </ul>
        </section>
      )}

      {tool.limitations.length > 0 && (
        <section aria-labelledby="limitaciones-title">
          <h2 id="limitaciones-title" class="display text-[30px]">{t('section.limitations')}</h2>
          <ul class="mt-5 flex flex-col gap-2.5" role="list">
            {tool.limitations.map((item: string) => (
              <li class="rounded-lg border border-brand-card-border bg-brand-surface p-4 text-[14px] leading-6 text-brand-text-muted">
                {item}
              </li>
            ))}
          </ul>
        </section>
      )}

      {tool.faq.length > 0 && (
        <section aria-labelledby="faq-title">
          <h2 id="faq-title" class="display text-[30px]">{t('section.faq')} {tool.name}</h2>
          <div class="mt-5 overflow-hidden rounded-lg border border-brand-card-border">
            {tool.faq.map((item: { question: string; answer: string }) => (
              <details class="group border-b border-brand-hairline bg-brand-surface last:border-b-0">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-4 text-[15px] font-semibold text-brand-text hover:bg-brand-surface-sunken">
                  {item.question}
                  <svg class="details-marker h-4 w-4 shrink-0 text-brand-text-subtle" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
                  </svg>
                </summary>
                <p class="px-4 pb-4 text-[14px] leading-7 text-brand-text-muted">{item.answer}</p>
              </details>
            ))}
          </div>
        </section>
      )}
    </div>

    <!-- Columna lateral -->
    <aside class="flex flex-col gap-8 lg:sticky lg:top-24 lg:self-start">
      <section class="rounded-lg border border-brand-card-border bg-brand-surface p-5" aria-labelledby="ficha-title">
        <h2 id="ficha-title" class="display text-[19px]">{t('tool.quickfacts')}</h2>
        <dl class="mt-4 flex flex-col gap-3 text-[13px]">
          {quickFacts.map((fact) => (
            <div class="flex items-baseline justify-between gap-4 border-b border-brand-hairline pb-3 last:border-b-0 last:pb-0">
              <dt class="shrink-0 text-brand-text-muted">{fact.label}</dt>
              <dd class="text-right font-medium text-brand-text">{fact.value}</dd>
            </div>
          ))}
        </dl>
      </section>

      {alternatives.length > 0 && (
        <section class="rounded-lg border border-brand-card-border bg-brand-surface p-5" aria-labelledby="alternativas-title">
          <h2 id="alternativas-title" class="display text-[19px]">{t('section.alternatives')}</h2>
          <ul class="mt-4 flex flex-col gap-1" role="list">
            {alternatives.map((alt: any) => (
              <li>
                <a
                  href={`/${lang}/${alt.slug}`}
                  class="flex items-start gap-3 rounded-md p-2 transition-colors hover:bg-brand-surface-sunken"
                >
                  <Monogram initials={getInitials(alt.name, alt.initials)} tone={getToolTone(alt.slug, alt.categories)} size="sm" />
                  <span class="min-w-0">
                    <span class="block text-[14px] font-semibold text-brand-text">{alt.name}</span>
                    <span class="mt-0.5 line-clamp-2 block text-[12px] leading-5 text-brand-text-muted">{alt.shortDescription}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {tool.officialSources.length > 0 && (
        <section class="rounded-lg border border-brand-card-border bg-brand-surface p-5" aria-labelledby="fuentes-title">
          <h2 id="fuentes-title" class="display text-[19px]">{t('tool.official-sources')}</h2>
          <ul class="mt-4 flex flex-col gap-1.5" role="list">
            {tool.officialSources.map((source: string) => (
              <li>
                <a
                  href={source}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="data-tag block truncate text-brand-secondary transition-colors hover:text-brand-primary"
                >{getDomain(source)}</a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </aside>
  </div>
</BaseLayout>
