---
// src/pages/[lang]/[slug].astro — ficha de herramienta (dirección 1a)
// Orden impuesto por el §6: encabezado + fuente oficial verificada en el primer
// viewport, alternativas inmediatamente después, y sólo entonces el detalle.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/ToolCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getTranslatedTools, getTranslatedTool } from '../../utils/tools';
import { useTranslations, languages } from '../../i18n/ui';
import {
  formatDate,
  getCategoryLabel,
  getCategory,
  getDomain,
  getInitials,
  PLATFORM_ORDER,
  type Lang
} from '../../utils/brand';

export async function getStaticPaths() {
  const locales = Object.keys(languages);
  const paths = [];

  for (const lang of locales) {
    const tools = await getTranslatedTools(lang);
    for (const tool of tools) {
      paths.push({ params: { lang, slug: tool.slug }, props: { tool, lang } });
    }
  }

  return paths;
}

const { tool, lang } = Astro.props as { tool: any; lang: Lang };
const t = useTranslations(lang);

const allTools = await getTranslatedTools(lang);
const toolsBySlug = new Map(allTools.map((entry) => [entry.slug, entry]));

const pricingLabels = {
  free: t('info.pricing.free'),
  freemium: t('info.pricing.freemium'),
  paid: t('info.pricing.paid'),
  enterprise: t('info.pricing.enterprise'),
  unknown: t('info.pricing.unknown')
};
const pricingLabel = pricingLabels[tool.pricingModel as keyof typeof pricingLabels] ?? pricingLabels.unknown;

const languageSupport = { es: tool.spanishSupport, sv: tool.swedishSupport, it: tool.italianSupport }[lang];
const languageLabels = {
  es: { yes: t('info.spanish.yes'), partial: t('info.spanish.partial'), no: t('info.spanish.no'), unknown: t('info.spanish.unknown') },
  sv: { yes: t('info.swedish.yes'), partial: t('info.swedish.partial'), no: t('info.swedish.no'), unknown: t('info.swedish.unknown') },
  it: { yes: t('info.italian.yes'), partial: t('info.italian.partial'), no: t('info.italian.no'), unknown: t('info.italian.unknown') }
}[lang];
const languageLabel = languageLabels[(languageSupport as keyof typeof languageLabels) ?? 'unknown'] ?? languageLabels.unknown;

const accountLabel = tool.requiresAccount === true
  ? t('info.account.required')
  : tool.requiresAccount === false
    ? t('info.account.optional')
    : t('info.account.unknown');

const platformNames: Record<string, string> = {
  web: t('platform.web'), windows: t('platform.windows'), mac: t('platform.mac'),
  linux: t('platform.linux'), android: t('platform.android'), ios: t('platform.ios')
};
const platformShort: Record<string, string> = {
  web: t('platform.short.web'), windows: t('platform.short.windows'), mac: t('platform.short.mac'),
  linux: t('platform.short.linux'), android: t('platform.short.android'), ios: t('platform.short.ios')
};
const platformTypeLabels: Record<string, string> = {
  'official-site': t('platform.type.official-site'),
  'app-store': t('platform.type.app-store'),
  'web-app': t('platform.type.web-app'),
  documentation: t('platform.type.documentation'),
  'official-installer': t('platform.type.official-installer'),
  'github-repo': t('platform.type.github-repo'),
  'package-manager': t('platform.type.package-manager')
};
const platformBtnLabels: Record<string, string> = {
  'official-site': t('platform.btn.official-site'),
  'app-store': t('platform.btn.app-store'),
  'web-app': t('platform.btn.web-app'),
  documentation: t('platform.btn.documentation'),
  'official-installer': t('platform.btn.official-installer'),
  'github-repo': t('platform.btn.github-repo'),
  'package-manager': t('platform.btn.package-manager')
};

const platforms = PLATFORM_ORDER
  .filter((key) => Boolean(tool.platforms[key]))
  .map((key) => {
    const details = tool.platforms[key] as any;
    return {
      id: key,
      name: platformNames[key] ?? key,
      short: platformShort[key],
      type: details.type,
      lastChecked: details.lastChecked,
      typeLabel: platformTypeLabels[details.type] ?? details.type,
      btnLabel: platformBtnLabels[details.type] ?? t('card.cta'),
      host: getDomain(details.url)
    };
  });

const primaryPlatform = platforms.find((item) => item.id === 'web') ?? platforms[0];
const primaryCta = primaryPlatform
  ? `/r?t=${tool.slug}&p=${primaryPlatform.id}&l=${lang}`
  : `/r?t=${tool.slug}&l=${lang}`;

const officialDomain = getDomain(tool.officialWebsite);
const initials = getInitials(tool.name, tool.initials);
const primaryCategorySlug = tool.categories[0] ?? '';
const primaryCategory = getCategory(primaryCategorySlug);
const categoryLabel = getCategoryLabel(primaryCategorySlug, lang);
const reviewDateLong = formatDate(tool.lastReviewed, lang, true);

// El repositorio oficial se deriva del catálogo, no se declara aparte.
const repoPlatformEntry = Object.entries(tool.platforms).find(
  ([, details]: [string, any]) => details && details.type === 'github-repo'
) as [string, any] | undefined;
const repoUrl: string | undefined =
  repoPlatformEntry?.[1]?.url ?? tool.officialSources.find((source: string) => /github\.com/i.test(source));
// Igual que cualquier otro botón de descarga: pasa por /r (verificación +
// linkzip.uk) en vez de saltar directo a GitHub. Solo es posible cuando el
// repo está declarado como plataforma (tiene una key de PLATFORM_ORDER); si
// viene de officialSources como respaldo, no hay `p` con el que enrutarlo.
const repoKey = repoPlatformEntry?.[0];
const repoCta = repoKey ? `/r?t=${tool.slug}&p=${repoKey}&l=${lang}` : repoUrl;
// Si el repo es la misma plataforma que ya ofrece el CTA principal, no
// dupliques el botón.
const showRepoLink = Boolean(repoUrl) && repoKey !== primaryPlatform?.id;

// §6 Alternatives — 6 como máximo, en 3 columnas, con fuente oficial.
// Se completan con herramientas verificadas de la misma categoría si la ficha
// declara menos de 6; nunca se rellena con algo de otra necesidad.
const declared = tool.alternatives
  .map((slug: string) => toolsBySlug.get(slug))
  .filter(Boolean);
const sameCategory = allTools.filter(
  (candidate) =>
    candidate.slug !== tool.slug &&
    candidate.categories.includes(primaryCategorySlug) &&
    !declared.some((entry: any) => entry.slug === candidate.slug)
);
const alternatives = [...declared, ...sameCategory].slice(0, 6);

const editorialSummary = tool.editorialSummary ?? tool.longDescription;
const bestFor = tool.bestFor.length > 0
  ? tool.bestFor
  : tool.tags.slice(0, 4).map((tag: string) =>
      lang === 'sv' ? `Användare som söker efter ${tag}`
        : lang === 'it' ? `Utenti che cercano ${tag}`
        : `Usuarios que buscan ${tag.replaceAll('-', ' ')}`
    );

const toolImage: string | undefined = tool.screenshotUrl ?? undefined;

const schemaApp = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: tool.name,
  description: tool.shortDescription,
  applicationCategory: 'OtherApplication',
  applicationSubCategory: 'Artificial Intelligence',
  operatingSystem: platforms.map((platform) => platform.name).join(', '),
  url: tool.officialWebsite,
  dateModified: tool.lastReviewed,
  ...(toolImage ? { image: toolImage } : {}),
  sameAs: repoUrl ? [...new Set([...tool.officialSources, repoUrl])] : tool.officialSources,
  offers: {
    '@type': 'Offer',
    price: tool.pricingModel === 'free' ? '0' : undefined,
    priceCurrency: tool.pricingModel === 'free' ? 'USD' : undefined
  }
};

const schemaBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('nav.home'), item: `${Astro.url.origin}/${lang}` },
    ...(primaryCategory
      ? [{ '@type': 'ListItem', position: 2, name: categoryLabel, item: `${Astro.url.origin}/${lang}/categoria/${primaryCategory.slug}` }]
      : []),
    { '@type': 'ListItem', position: primaryCategory ? 3 : 2, name: tool.name, item: Astro.url.href }
  ]
};

const schemaFaq = tool.faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: tool.faq.map((item: { question: string; answer: string }) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer }
  }))
} : null;

const jsonLd = schemaFaq ? [schemaApp, schemaBreadcrumb, schemaFaq] : [schemaApp, schemaBreadcrumb];

const alternatePromises = Object.keys(languages).map(async (l) => {
  const exists = await getTranslatedTool(l, tool.slug);
  return exists ? { lang: l, url: `${Astro.url.origin}/${l}/${tool.slug}` } : null;
});
const resolvedAlternates = (await Promise.all(alternatePromises)).filter(Boolean) as Array<{ lang: string; url: string }>;

// §7 — <title>{Nombre} — sitio oficial y {n} alternativas verificadas
const docTitle = lang === 'sv'
  ? `${tool.name} — officiell webbplats och ${alternatives.length} verifierade alternativ | FuenteAI`
  : lang === 'it'
    ? `${tool.name} — sito ufficiale e ${alternatives.length} alternative verificate | FuenteAI`
    : `${tool.name} — sitio oficial y ${alternatives.length} alternativas verificadas | FuenteAI`;

// §7 — description con el one-liner + dominio oficial
const docDesc = `${tool.shortDescription} ${lang === 'sv' ? 'Officiell källa' : lang === 'it' ? 'Fonte ufficiale' : 'Fuente oficial'}: ${officialDomain}.`;

const slugify = (value: string) =>
  value.toLowerCase().replace(new RegExp('[^a-z0-9]+', 'g'), '-').replace(new RegExp('(^-|-$)', 'g'), '');

const metaChips = [
  pricingLabel,
  ...platforms.slice(0, 4).map((platform) => platform.short)
];
---

<BaseLayout
  title={docTitle}
  description={docDesc}
  jsonLd={jsonLd}
  lang={lang}
  alternates={resolvedAlternates}
  ogImage={toolImage}
>
  <nav class="fai-mono-sm flex flex-wrap items-center gap-2 pt-7 text-fai-muted-2" aria-label="Breadcrumb">
    <a href={`/${lang}`} class="transition-colors hover:text-fai-signal">FuenteAI</a>
    <span aria-hidden="true">/</span>
    {primaryCategory && (
      <>
        <a href={`/${lang}/categoria/${primaryCategory.slug}`} class="transition-colors hover:text-fai-signal">{categoryLabel}</a>
        <span aria-hidden="true">/</span>
      </>
    )}
    <span class="text-fai-muted" aria-current="page">{tool.name}</span>
  </nav>

  <!-- ENCABEZADO + FUENTE OFICIAL (primer viewport) -->
  <header class="mt-7 grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,420px)] lg:items-start">
    <div class="min-w-0">
      <div class="flex items-center gap-4">
        <span class="fai-avatar fai-avatar--find h-14 w-14 text-[24px]" aria-hidden="true">{initials.slice(0, 1)}</span>
        <h1 class="fai-h2 min-w-0 text-fai-ink">{tool.name}</h1>
      </div>

      <p class="fai-mono-sm mt-4 flex flex-wrap items-center gap-x-2.5 gap-y-2 text-fai-muted-2">
        {metaChips.map((chip, index) => (
          <>
            {index > 0 && <span aria-hidden="true">·</span>}
            <span>{chip}</span>
          </>
        ))}
      </p>

      <p class="mt-5 max-w-[62ch] text-[16px] leading-[1.55] text-fai-ink-2">
        {tool.shortDescription}
      </p>

      <!-- En móvil cae entre la descripción y el CTA (mismo orden del DOM);
           en desktop queda en la columna izquierda sin desplazar la tarjeta
           de la derecha (lg:items-start). -->
      <AdSlot slotId={`ad-tool-top-${tool.slug}`} format="bar" network="banner-320x50" eager class="mt-5" />
    </div>

    <!-- §6 OfficialSource — siempre above the fold -->
    <aside
      class="rounded-[14px] border border-[rgba(15,191,143,.28)] bg-[linear-gradient(150deg,rgba(15,191,143,.12),rgba(15,191,143,.03))] p-5"
      aria-labelledby="fuente-oficial-title"
    >
      <h2 id="fuente-oficial-title" class="fai-mono-sm text-fai-signal">{t('official.title')}</h2>

      <div class="mt-3.5 flex flex-wrap items-center gap-3 rounded-[10px] border border-fai-line bg-[#04120e]/60 p-3">
        <span class="fai-domain min-w-0 flex-1 !text-[14px] overflow-x-auto">{officialDomain}</span>
        <a
          href={primaryCta}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 shrink-0 items-center justify-center rounded-[8px] bg-fai-find px-4 text-[13px] font-semibold !text-[#06231c] transition-opacity hover:opacity-90"
        >
          {t('official.download')}
          <span class="sr-only">— {tool.name}</span>
        </a>
      </div>

      {showRepoLink && (
        <a
          href={repoCta}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-2.5 flex flex-wrap items-center justify-between gap-x-3 gap-y-1 rounded-[10px] border border-fai-line bg-[#04120e]/40 p-3 transition-colors hover:border-[rgba(15,191,143,.5)]"
        >
          <span class="fai-domain min-w-0 truncate">{getDomain(repoUrl!)}{new URL(repoUrl!).pathname}</span>
          <span class="fai-mono-sm shrink-0 text-fai-muted-2">{t('official.repo')} ↗</span>
        </a>
      )}

      <p class="mt-3.5 text-[13px] leading-[1.5] text-fai-muted-2 sm:text-[12px]">
        {reviewDateLong
          ? `${t('official.mirrors')} ${t('official.reviewed')} ${reviewDateLong}.`
          : t('official.mirrors')}
      </p>
    </aside>
  </header>

  <!-- §6 Alternatives — inmediatamente después del encabezado -->
  {alternatives.length > 0 && (
    <section class="mt-14" aria-labelledby="alternativas-title">
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-b border-fai-line pb-4">
        <h2 id="alternativas-title" class="fai-section-title text-fai-ink">
          {t('alt.title').replace('{name}', tool.name)}
          <span class="fai-mono-sm ml-2.5 text-fai-find">{alternatives.length} {t('alt.count')}</span>
        </h2>
        <p class="fai-mono-sm text-fai-muted-2">{t('alt.all-official')}</p>
      </div>

      <div class="fai-grid--3 mt-6">
        {alternatives.map((alt: any, index: number) => (
          <ToolCard tool={alt} index={index} />
        ))}
      </div>
    </section>
  )}

  <!-- DETALLE -->
  <div class="mt-16 grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,300px)] lg:gap-14">
    <div class="flex min-w-0 flex-col gap-14">
      <section id="compatibilidad" class="scroll-mt-24" aria-labelledby="descargas-title">
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-b border-fai-line pb-4">
          <h2 id="descargas-title" class="fai-section-title text-fai-ink">{t('tool.platforms.title')}</h2>
          <p class="fai-mono-sm text-fai-muted-2">{t('tool.platforms.note')}</p>
        </div>

        <ul class="mt-6 flex flex-col gap-2.5" role="list">
          {platforms.map(({ id, name, typeLabel, host, lastChecked, btnLabel }) => (
            <li class="fai-live flex flex-col gap-3 rounded-[14px] p-4 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
              <div class="min-w-0">
                <h3 class="text-[15px] font-medium text-fai-ink">{name}</h3>
                <p class="mt-0.5 text-[14px] text-fai-muted sm:text-[13px]">{typeLabel}</p>
                <p class="fai-domain mt-2 !text-[11px] text-fai-muted-2">
                  {host}{lastChecked && formatDate(lastChecked, lang) && <> · rev. {formatDate(lastChecked, lang)}</>}
                </p>
              </div>
              <a
                href={`/r?t=${tool.slug}&p=${id}&l=${lang}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-11 shrink-0 items-center justify-center rounded-[8px] border border-[rgba(15,191,143,.4)] px-4 text-[13px] font-medium text-fai-signal transition-colors hover:bg-[rgba(15,191,143,.12)]"
              >
                {btnLabel}
                <span class="sr-only">— {name}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <AdSlot slotId={`ad-tool-native-${tool.slug}`} format="native" network="banner-320x50" />

      <section aria-labelledby="mejor-para-title">
        <h2 id="mejor-para-title" class="fai-section-title border-b border-fai-line pb-4 text-fai-ink">
          {t('section.best-for')} {tool.name}
        </h2>
        <ul class="mt-6 grid gap-2.5 sm:grid-cols-2" role="list">
          {bestFor.map((item: string) => (
            <li class="flex gap-2.5 rounded-[14px] border border-fai-line bg-fai-card p-4">
              <svg class="mt-0.5 h-4 w-4 shrink-0 text-fai-signal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20 6 9 17l-5-5" />
              </svg>
              <span class="text-[14px] leading-[1.5] text-fai-ink-2">{item}</span>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="resumen-title">
        <h2 id="resumen-title" class="fai-section-title border-b border-fai-line pb-4 text-fai-ink">
          {lang === 'sv' ? `Vad du bör veta om ${tool.name}`
            : lang === 'it' ? `Cosa dovresti sapere prima di usare ${tool.name}`
            : `Qué debes saber antes de usar ${tool.name}`}
        </h2>
        <p class="mt-6 max-w-[68ch] text-[15px] leading-[1.6] text-fai-muted">{editorialSummary}</p>
      </section>

      {tool.editorialSections.length > 0 && (
        <section aria-labelledby="guia-title">
          <h2 id="guia-title" class="fai-section-title border-b border-fai-line pb-4 text-fai-ink">
            {lang === 'sv' ? `Guide till ${tool.name} utan spegelsajter`
              : lang === 'it' ? `Guida all'uso di ${tool.name} in sicurezza`
              : `Guía completa para usar ${tool.name} sin caer en descargas falsas`}
          </h2>
          <div class="mt-6 flex flex-col gap-9">
            {tool.editorialSections.map((section: { heading: string; body: string }, index: number) => (
              <>
                <section aria-labelledby={`${tool.slug}-${slugify(section.heading)}`}>
                  <h3 id={`${tool.slug}-${slugify(section.heading)}`} class="text-[19px] font-bold tracking-[-0.02em] text-fai-ink">
                    {section.heading}
                  </h3>
                  <div class="mt-3 flex max-w-[68ch] flex-col gap-3 text-[15px] leading-[1.6] text-fai-muted">
                    {section.body.split('\n\n').map((paragraph: string) => <p>{paragraph}</p>)}
                  </div>
                </section>
                {index === Math.ceil(tool.editorialSections.length / 2) - 1 && (
                  <AdSlot slotId={`ad-tool-mid-${tool.slug}`} format="banner-300x250" network="banner-300x250" class="mx-auto" />
                )}
              </>
            ))}
          </div>
        </section>
      )}

      {tool.safetyNotes.length > 0 && (
        <section class="rounded-[14px] border border-[rgba(198,242,78,.28)] bg-[rgba(198,242,78,.05)] p-5 sm:p-6" aria-labelledby="seguridad-title">
          <h2 id="seguridad-title" class="fai-mono-sm text-fai-find">{t('section.safety')}</h2>
          <ul class="mt-4 flex flex-col gap-2.5" role="list">
            {tool.safetyNotes.map((note: string) => (
              <li class="text-[14px] leading-[1.55] text-fai-ink-2">{note}</li>
            ))}
          </ul>
        </section>
      )}

      {tool.limitations.length > 0 && (
        <section aria-labelledby="limitaciones-title">
          <h2 id="limitaciones-title" class="fai-section-title border-b border-fai-line pb-4 text-fai-ink">{t('section.limitations')}</h2>
          <ul class="mt-6 flex flex-col gap-2.5" role="list">
            {tool.limitations.map((item: string) => (
              <li class="rounded-[14px] border border-fai-line bg-fai-card p-4 text-[14px] leading-[1.55] text-fai-muted">{item}</li>
            ))}
          </ul>
        </section>
      )}

      {tool.faq.length > 0 && (
        <section aria-labelledby="faq-title">
          <h2 id="faq-title" class="fai-section-title border-b border-fai-line pb-4 text-fai-ink">{t('section.faq')}</h2>
          <div class="mt-2">
            {tool.faq.map((item: { question: string; answer: string }) => (
              <details class="group border-b border-fai-line">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-[15px] font-medium text-fai-ink transition-colors hover:text-fai-signal">
                  {item.question}
                  <svg class="details-marker h-4 w-4 shrink-0 text-fai-muted-2" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
                  </svg>
                </summary>
                <p class="pb-4 text-[14px] leading-[1.6] text-fai-muted">{item.answer}</p>
              </details>
            ))}
          </div>
        </section>
      )}
    </div>

    <aside class="flex flex-col gap-6 lg:sticky lg:top-24 lg:self-start">
      <section class="rounded-[14px] border border-fai-line bg-fai-card p-5" aria-labelledby="ficha-title">
        <h2 id="ficha-title" class="fai-mono-sm text-fai-muted-2">{t('tool.quickfacts')}</h2>
        <dl class="mt-4 flex flex-col gap-3 text-[14px] sm:text-[13px]">
          {[
            { label: t('tool.price'), value: pricingLabel },
            { label: t('tool.account'), value: accountLabel },
            { label: t('tool.language'), value: languageLabel },
            { label: t('tool.platforms.count'), value: String(platforms.length) }
          ].map((fact) => (
            <div class="flex items-baseline justify-between gap-4 border-b border-fai-line pb-3 last:border-b-0 last:pb-0">
              <dt class="shrink-0 text-fai-muted-2">{fact.label}</dt>
              <dd class="text-right text-fai-ink">{fact.value}</dd>
            </div>
          ))}
        </dl>
      </section>

      {tool.officialSources.length > 0 && (
        <section class="rounded-[14px] border border-fai-line bg-fai-card p-5" aria-labelledby="fuentes-title">
          <h2 id="fuentes-title" class="fai-mono-sm text-fai-muted-2">{t('tool.official-sources')}</h2>
          <ul class="mt-4 flex flex-col gap-2" role="list">
            {tool.officialSources.map((source: string) => (
              <li>
                <a href={source} target="_blank" rel="noopener noreferrer" class="fai-domain block truncate transition-colors hover:text-fai-find">
                  {getDomain(source)}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </aside>
  </div>
