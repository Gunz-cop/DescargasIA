---
// src/pages/r/index.astro
import '../../styles/global.css';
import { getCollection } from 'astro:content';
import linkzipCache from '../../linkzip-cache.json';
import AdSlot from '../../components/AdSlot.astro';

const REDIRECT_DELAY_SECONDS = 5;

const baseTools = await getCollection('toolsBase');

const toolsDb = baseTools.reduce((acc, tool) => {
  const getUrl = (origUrl: string) => (linkzipCache as Record<string, string>)[origUrl] ?? origUrl;
  
  // `url` es a donde se navega (puede pasar por el acortador monetizado);
  // `displayUrl` es la URL oficial real y es la unica que se muestra en
  // pantalla: ensenar el dominio del acortador en el aviso de destino hacia
  // desconfiar a la gente, porque no coincide con la web que pidio.
  acc[tool.id] = {
    name: tool.data.name,
    officialWebsite: getUrl(tool.data.officialWebsite),
    officialWebsiteDisplay: tool.data.officialWebsite,
    platforms: Object.entries(tool.data.platforms).reduce((plats, [key, val]) => {
      if (val) {
        plats[key] = {
          url: getUrl(val.url),
          displayUrl: val.url,
          isOfficial: val.isOfficial,
          type: val.type
        };
      }
      return plats;
    }, {} as Record<string, { url: string; displayUrl: string; isOfficial: boolean; type: string }>)
  };
  return acc;
}, {} as Record<string, any>);
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Redirección segura | FuenteAI</title>
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0e10" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script src="../../scripts/redirect-theme.ts"></script>
  </head>
  <body class="flex min-h-screen flex-col items-center justify-center bg-brand-bg p-5">
    <div class="w-full max-w-md rounded-lg border border-brand-card-border bg-brand-surface p-7">
      <!-- Indicador de progreso -->
      <div id="redirect-spinner" class="mb-5 h-1 w-full overflow-hidden rounded-full bg-brand-surface-sunken" aria-hidden="true">
        <div class="h-full w-1/3 animate-pulse rounded-full bg-brand-primary"></div>
      </div>

      <!-- Redirección verificada -->
      <div id="redirect-content" hidden>
        <h1 id="redirect-heading" class="display text-[20px]">Redirección segura</h1>
        <p id="redirect-connecting" class="mt-2 text-[14px] leading-6 text-brand-text-muted">
          Te estamos conectando de forma transparente...
        </p>
        <p id="redirect-destination" class="data-tag mt-4 rounded-md border border-brand-success-border bg-brand-success-bg px-3 py-2 text-brand-success">
          Destino:
        </p>

        <!-- Arriba del anuncio y bien visible: que quede claro que la persona
             va a llegar a su destino sí o sí, para que no sienta que la
             desviamos a una pantalla de publicidad y abandone el sitio. -->
        <p id="redirect-countdown-line" class="mt-4 flex items-center justify-center gap-2 text-[15px] text-brand-text">
          <span id="redirect-countdown-text">Redirigiendo en</span>
          <span id="redirect-countdown" class="inline-flex h-7 min-w-7 items-center justify-center rounded-full bg-brand-primary px-2 text-[15px] font-bold text-brand-on-primary">{REDIRECT_DELAY_SECONDS}</span>
          <span aria-hidden="true">s</span>
        </p>

        <AdSlot slotId="ad-redirect-native" format="card" network="native-banner" eager class="mt-4" />

        <p id="redirect-fallback" class="mt-3 text-[12px] leading-5 text-brand-text-subtle">
          Si la redirección no se completa automáticamente, usa el botón.
        </p>
        <a
          href=""
          id="redirect-btn"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 inline-flex min-h-12 w-full items-center justify-center rounded-md bg-brand-primary px-5 text-[14px] font-semibold text-brand-on-primary transition-colors hover:bg-brand-primary-hover"
        >
          Continuar
        </a>
      </div>

      <!-- Error de validación -->
      <div id="error-box" hidden>
        <h1 id="error-title" class="display text-[20px]">Enlace no verificado</h1>
        <p id="error-desc" class="mt-2 text-[14px] leading-6 text-brand-text-muted">
          El enlace solicitado no pertenece a un canal oficial registrado en nuestro directorio.
        </p>
        <a
          href="/"
          id="error-btn"
          class="mt-5 inline-flex min-h-12 w-full items-center justify-center rounded-md border border-brand-card-border bg-brand-surface px-5 text-[14px] font-medium text-brand-text transition-colors hover:bg-brand-surface-sunken"
        >
          Volver al directorio
        </a>
      </div>
    </div>

    <script id="redirect-data" type="application/json" set:html={JSON.stringify({ toolsDb, delay: REDIRECT_DELAY_SECONDS })}></script>
    <script src="../../scripts/redirect.ts"></script>
  </body>
</html>
