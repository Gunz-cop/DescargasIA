---
// src/pages/r/index.astro
import '../../styles/global.css';
import { getCollection } from 'astro:content';
import linkzipCache from '../../linkzip-cache.json';
import AdSlot from '../../components/AdSlot.astro';

const REDIRECT_DELAY_SECONDS = 5;

const baseTools = await getCollection('toolsBase');

const toolsDb = baseTools.reduce((acc, tool) => {
  const getUrl = (origUrl: string) => (linkzipCache as Record<string, string>)[origUrl] ?? origUrl;
  
  acc[tool.id] = {
    name: tool.data.name,
    officialWebsite: getUrl(tool.data.officialWebsite),
    platforms: Object.entries(tool.data.platforms).reduce((plats, [key, val]) => {
      if (val) {
        plats[key] = {
          url: getUrl(val.url),
          isOfficial: val.isOfficial
        };
      }
      return plats;
    }, {} as Record<string, { url: string; isOfficial: boolean }>)
  };
  return acc;
}, {} as Record<string, any>);
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Redirección segura | FuenteAI</title>
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0e10" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      (() => {
        let theme = 'light';
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') {
            theme = stored;
          } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            theme = 'dark';
          }
        } catch (error) {
          /* sin acceso a localStorage */
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col items-center justify-center bg-brand-bg p-5">
    <div class="w-full max-w-md rounded-lg border border-brand-card-border bg-brand-surface p-7">
      <!-- Indicador de progreso -->
      <div id="redirect-spinner" class="mb-5 h-1 w-full overflow-hidden rounded-full bg-brand-surface-sunken" aria-hidden="true">
        <div class="h-full w-1/3 animate-pulse rounded-full bg-brand-primary"></div>
      </div>

      <!-- Redirección verificada -->
      <div id="redirect-content" hidden>
        <h1 id="redirect-heading" class="display text-[20px]">Redirección segura</h1>
        <p id="redirect-connecting" class="mt-2 text-[14px] leading-6 text-brand-text-muted">
          Te estamos conectando de forma transparente...
        </p>
        <p id="redirect-destination" class="data-tag mt-4 rounded-md border border-brand-success-border bg-brand-success-bg px-3 py-2 text-brand-success">
          Destino:
        </p>

        <!-- Arriba del anuncio y bien visible: que quede claro que la persona
             va a llegar a su destino sí o sí, para que no sienta que la
             desviamos a una pantalla de publicidad y abandone el sitio. -->
        <p id="redirect-countdown-line" class="mt-4 flex items-center justify-center gap-2 text-[15px] text-brand-text">
          <span id="redirect-countdown-text">Redirigiendo en</span>
          <span id="redirect-countdown" class="inline-flex h-7 min-w-7 items-center justify-center rounded-full bg-brand-primary px-2 text-[15px] font-bold text-brand-on-primary">{REDIRECT_DELAY_SECONDS}</span>
          <span aria-hidden="true">s</span>
        </p>

        <AdSlot slotId="ad-redirect-native" format="card" network="native-banner" eager class="mt-4" />

        <p id="redirect-fallback" class="mt-3 text-[12px] leading-5 text-brand-text-subtle">
          Si la redirección no se completa automáticamente, usa el botón.
        </p>
        <a
          href=""
          id="redirect-btn"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 inline-flex min-h-12 w-full items-center justify-center rounded-md bg-brand-primary px-5 text-[14px] font-semibold text-brand-on-primary transition-colors hover:bg-brand-primary-hover"
        >
          Continuar
        </a>
      </div>

      <!-- Error de validación -->
      <div id="error-box" hidden>
        <h1 id="error-title" class="display text-[20px]">Enlace no verificado</h1>
        <p id="error-desc" class="mt-2 text-[14px] leading-6 text-brand-text-muted">
          El enlace solicitado no pertenece a un canal oficial registrado en nuestro directorio.
        </p>
        <a
          href="/"
          id="error-btn"
          class="mt-5 inline-flex min-h-12 w-full items-center justify-center rounded-md border border-brand-card-border bg-brand-surface px-5 text-[14px] font-medium text-brand-text transition-colors hover:bg-brand-surface-sunken"
        >
          Volver al directorio
        </a>
      </div>
    </div>

    <!-- Client Script -->
    <script is:inline define:vars={{ toolsDb, REDIRECT_DELAY_SECONDS }}>
      document.addEventListener('DOMContentLoaded', () => {
        const params = new URLSearchParams(window.location.search);
        const toolId = params.get('t');
        const platformId = params.get('p');
        const lang = params.get('l') || 'es';

        const translations = {
          es: {
            title: "Redirigiendo a la web oficial de {name} | FuenteAI",
            heading: "Redirección segura en curso",
            connecting: "Te estamos conectando de forma transparente con la web oficial de ",
            destination: "Destino verificado:",
            countdown: "Redirigiendo en",
            fallback: "Si la redirección no se completa automáticamente, haz clic en el botón inferior.",
            btn: "Continuar a",
            errorTitle: "Enlace no verificado",
            errorDesc: "La combinación de herramienta y plataforma solicitada no existe o no es un canal oficial verificado.",
            errorBtn: "Volver al Directorio"
          },
          sv: {
            title: "Omdirigerar till officiella webbplatsen för {name} | FuenteAI",
            heading: "Säker omdirigering pågår",
            connecting: "Vi ansluter dig nu till den officiella webbplatsen för ",
            destination: "Verifierad destination:",
            countdown: "Omdirigerar om",
            fallback: "Klicka på knappen nedan om du inte omdirigeras automatiskt.",
            btn: "Fortsätt till",
            errorTitle: "Länk ej verifierad",
            errorDesc: "Den begärda kombinationen av verktyg och plattform finns inte eller är inte en verifierad officiell kanal.",
            errorBtn: "Tillbaka till hem"
          },
          it: {
            title: "Reindirizzamento al sito ufficiale di {name} | FuenteAI",
            heading: "Reindirizzamento sicuro in corso",
            connecting: "Ti stiamo connettendo in modo trasparente con il sito ufficiale di ",
            destination: "Destinazione verificata:",
            countdown: "Reindirizzamento tra",
            fallback: "Se il reindirizzamento non avviene automaticamente, fai clic sul pulsante in basso.",
            btn: "Continua su",
            errorTitle: "Link non verificato",
            errorDesc: "La combinazione di strumento e piattaforma richiesta non esiste o non è un canale ufficiale verificato.",
            errorBtn: "Torna alla home"
          }
        };

        const t = translations[lang] || translations.es;

        // Elements
        const spinner = document.getElementById('redirect-spinner');
        const content = document.getElementById('redirect-content');
        const errorBox = document.getElementById('error-box');

        const heading = document.getElementById('redirect-heading');
        const connecting = document.getElementById('redirect-connecting');
        const destination = document.getElementById('redirect-destination');
        const countdownText = document.getElementById('redirect-countdown-text');
        const countdownEl = document.getElementById('redirect-countdown');
        const fallback = document.getElementById('redirect-fallback');
        const btn = document.getElementById('redirect-btn');

        const errTitle = document.getElementById('error-title');
        const errDesc = document.getElementById('error-desc');
        const errBtn = document.getElementById('error-btn');

        // Validation
        const tool = toolsDb[toolId];
        let targetUrl = '';
        let name = '';

        if (tool) {
          name = tool.name;
          if (platformId) {
            const plat = tool.platforms[platformId];
            if (plat && plat.isOfficial) {
              targetUrl = plat.url;
            }
          } else {
            // Fallback to officialWebsite
            targetUrl = tool.officialWebsite;
          }
        }

        if (targetUrl) {
          // Update HTML texts
          document.title = t.title.replace('{name}', name);
          heading.textContent = t.heading;
          connecting.innerHTML = `${t.connecting}<strong class="text-brand-text font-bold">${name}</strong>.`;
          
          let hostname = '';
          try {
            hostname = new URL(targetUrl).hostname.replace(/^www\./, '');
          } catch {
            hostname = targetUrl;
          }
          
          destination.textContent = `${t.destination} ${hostname}`;
          countdownText.textContent = t.countdown;
          fallback.textContent = t.fallback;
          btn.textContent = `${t.btn} ${hostname}`;
          btn.href = targetUrl;

          // Show redirect view, hide error view
          content.hidden = false;
          errorBox.hidden = true;

          // Auto redirect: se mantiene la pantalla el tiempo suficiente para
          // registrar una impresión publicitaria válida antes de continuar.
          // El contador va arriba del anuncio, bien visible, para que quede
          // claro desde el primer momento que esto es una redirección con
          // tiempo fijo y no una pantalla de publicidad disfrazada.
          let remaining = REDIRECT_DELAY_SECONDS;
          const tick = setInterval(() => {
            remaining -= 1;
            countdownEl.textContent = String(Math.max(remaining, 0));
            if (remaining <= 0) clearInterval(tick);
          }, 1000);

          setTimeout(() => {
            window.location.replace(targetUrl);
          }, REDIRECT_DELAY_SECONDS * 1000);
        } else {
          // Validation failed
          document.title = t.errorTitle + ' | FuenteAI';
          errTitle.textContent = t.errorTitle;
          errDesc.textContent = t.errorDesc;
          errBtn.textContent = t.errorBtn;
          errBtn.href = `/${lang}`;

          // Hide redirect view, show error view
          spinner.hidden = true;
          content.hidden = true;
          errorBox.hidden = false;
        }
      });
    </script>
  </body>
</html>
