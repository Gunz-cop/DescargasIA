---
// src/pages/404.astro
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'Página no encontrada (404) | FuenteAI';
const pageDesc = 'La página que buscas no existe o ha sido movida. Vuelve al directorio de canales oficiales de herramientas de IA.';
---

<BaseLayout title={pageTitle} description={pageDesc} noindex={true}>
  <div class="mx-auto flex max-w-lg flex-col items-start py-24">
    <p class="eyebrow text-brand-primary">Error 404</p>
    <h1 class="display mt-4 text-[42px] sm:text-[56px]">Esta página no está en el índice</h1>
    <p class="mt-4 text-[15px] leading-7 text-brand-text-muted">
      El enlace puede estar roto o la ficha se retiró temporalmente para una nueva revisión.
      Desde el directorio puedes buscar cualquier herramienta por nombre.
    </p>
    <div class="mt-8 flex flex-col gap-2.5 sm:flex-row">
      <a
        href="/"
        class="inline-flex min-h-12 items-center justify-center rounded-md bg-brand-primary px-5 text-[14px] font-semibold text-brand-on-primary transition-colors hover:bg-brand-primary-hover"
      >
        Volver al directorio
      </a>
      <a
        href="/es/acerca-de"
        class="inline-flex min-h-12 items-center justify-center rounded-md border border-brand-card-border bg-brand-surface px-5 text-[14px] font-medium text-brand-text transition-colors hover:border-brand-text/30 hover:bg-brand-surface-sunken"
      >
        Metodología editorial
      </a>
    </div>
  </div>
</BaseLayout>
