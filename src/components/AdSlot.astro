---
// src/components/AdSlot.astro
// Reserva el hueco publicitario y, cuando se le pasa `network`, carga el
// creativo real de Adsterra correspondiente. Sin `network`, se queda en
// modo placeholder (solo el hueco reservado y la etiqueta).
//
// `eager` controla cuándo se pide el script de la red publicitaria:
// - eager: el script se inserta de inmediato en el HTML (para el único
//   hueco que ya vive en la primera pantalla — ahí no hay nada que diferir,
//   el usuario lo va a ver igual sin necesidad de scroll).
// - lazy (por defecto): el contenedor se reserva con su alto final para no
//   causar salto de layout, pero el script de terceros no se pide hasta que
//   el hueco entra en viewport (IntersectionObserver, rootMargin 300px). Así
//   los anuncios que están más abajo en la página no compiten por ancho de
//   banda ni bloquean el hilo principal durante la carga inicial.
interface Props {
  /** Determina alto/ancho reservado. */
  format?: 'native' | 'banner-300x250' | 'bar' | 'card';
  /** Qué creativo de Adsterra cargar en este hueco. Omitir = placeholder. */
  network?: 'native-banner' | 'banner-300x250' | 'banner-320x50';
  /** Identificador estable del contenedor visual (no del script de Adsterra). */
  slotId: string;
  /** true solo para el hueco que ya está en la primera pantalla sin scroll. */
  eager?: boolean;
  class?: string;
}

const { format = 'native', network, slotId, eager = false, class: className = '' } = Astro.props;

// Alto FIJO (no min-h) + overflow-hidden: ningún creativo de terceros puede
// empujar el layout de la página, sin importar qué tan grande venga la
// imagen/HTML que inyecte su script. Los banners atOptions viven en un
// iframe de tamaño exacto, así que encajan sin recorte; si algún día vuelve
// a usarse el Native Banner (HTML crudo, sin límite propio) quedará recortado
// en vez de invadir el resto de la página.
const dims: Record<string, string> = {
  native: 'h-[66px] overflow-hidden',
  'banner-300x250': 'h-[266px] sm:max-w-[316px] sm:mx-auto overflow-hidden',
  bar: 'h-[70px] overflow-hidden',
  // Para el Magic Banner (grid de bloques cuadrados, configurado 1 fila x 2
  // que en móvil cae a 1 columna de 2). No conocemos su alto exacto de
  // antemano, así que se reserva generoso pero con un tope duro: si algún
  // día sirve un creativo más alto de lo esperado, se recorta en vez de
  // volver a romper el layout de la página.
  card: 'max-h-[440px] overflow-hidden'
};

// Native Banner — una sola instancia por carga de página (recomendación de Adsterra).
const NATIVE_CONTAINER_ID = 'container-fa1e8876d85c18dfb461e25de7b492d5';
const NATIVE_SRC = 'https://pl30788864.effectivecpmnetwork.com/fa1e8876d85c18dfb461e25de7b492d5/invoke.js';

// Banners "highperformanceformat" (atOptions + invoke.js por tamaño).
const BANNER_KEYS: Record<string, string> = {
  'banner-300x250': '1bdd21d4821614421dcf647bc99a473e',
  'banner-320x50': '61f98306735e1c9df254c5d978e24994'
};
const BANNER_DIMS: Record<string, { width: number; height: number }> = {
  'banner-300x250': { width: 300, height: 250 },
  'banner-320x50': { width: 320, height: 50 }
};

const adConfig = network
  ? network === 'native-banner'
    ? { kind: 'native-banner', containerId: NATIVE_CONTAINER_ID, src: NATIVE_SRC }
    : { kind: 'banner', src: `https://www.highperformanceformat.com/${BANNER_KEYS[network]}/invoke.js`, atOptions: { key: BANNER_KEYS[network], format: 'iframe', ...BANNER_DIMS[network], params: {} } }
  : null;
---

<div
  id={slotId}
  data-ad-slot={format}
  data-ad-network={network}
  data-ad-kind={adConfig?.kind}
  data-ad-src={adConfig?.src}
  data-ad-key={adConfig?.kind === 'banner' ? adConfig.atOptions.key : undefined}
  data-ad-width={adConfig?.kind === 'banner' ? adConfig.atOptions.width : undefined}
  data-ad-height={adConfig?.kind === 'banner' ? adConfig.atOptions.height : undefined}
  data-ad-eager={adConfig && eager ? 'true' : undefined}
  class:list={[
    'flex flex-col items-center justify-center gap-1 rounded-[14px] border border-fai-line bg-fai-card/60 px-4 py-3 text-center',
    dims[format],
    className
  ]}
>
  <span class="fai-mono-sm uppercase tracking-wide text-fai-muted-2">Publicidad</span>

  {adConfig?.kind === 'native-banner' && <div id={adConfig.containerId}></div>}

  {adConfig && <script src="../scripts/ads.ts"></script>}
</div>
