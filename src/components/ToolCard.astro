---
// src/components/ToolCard.astro — §6 ToolCard
//
// Pie en COLUMNA, nunca en fila con space-between: a 253px de ancho de columna
// una fila parte el dominio y el badge en dos líneas. El dominio es la prueba
// de confianza, así que no se trunca ni se parte (`white-space: nowrap`).
import {
  getDomain,
  getInitials,
  PLATFORM_ORDER,
  type Lang,
  type PlatformKey
} from '../utils/brand';
import { useTranslations } from '../i18n/ui';
import { toolUrl } from '../utils/links';

interface Props {
  tool: {
    name: string;
    slug: string;
    shortDescription: string;
    officialWebsite: string;
    categories: string[];
    pricingModel: 'free' | 'freemium' | 'paid' | 'enterprise' | 'unknown';
    trustLevel: 'official' | 'verified' | 'pending-review';
    tags?: string[];
    initials?: string;
    platforms: Partial<Record<PlatformKey, PlatformDetails>>;
  };
  /** Posición en la rejilla: alimenta el retraso de la cascada (§3.2). */
  index?: number;
  /**
   * Depende del campo `knownBy` del §4, que el catálogo todavía no tiene.
   * Mientras no exista, la tarjeta no muestra badge: afirmar "ya la conocías"
   * sobre las 26 fichas sería un dato inventado sobre el visitante.
   */
  variant?: 'find' | 'known';
}

interface PlatformDetails {
  url: string;
  type: string;
  isOfficial: boolean;
  lastChecked?: string;
}

const { tool, index = 0, variant } = Astro.props;
const lang = (Astro.currentLocale || 'es') as Lang;
const t = useTranslations(lang);

const initials = getInitials(tool.name, tool.initials);
const domain = getDomain(tool.officialWebsite);
const availablePlatforms = PLATFORM_ORDER.filter((platform) => Boolean(tool.platforms[platform]));

const searchIndex = [tool.name, tool.slug, ...(tool.tags ?? [])]
  .join(' ')
  .toLowerCase()
  .normalize('NFD')
  .replace(new RegExp('[\\u0300-\\u036f]', 'g'), '');
---

<article
  class="fai-rise fai-live relative flex h-full flex-col rounded-[14px] p-5"
  data-rise-index={index}
  data-name={searchIndex}
  data-slug={tool.slug}
  data-categories={tool.categories.join(',')}
  data-pricing={tool.pricingModel}
  data-platforms={availablePlatforms.join(',')}
>
  <div class="flex items-center gap-3">
    <span
      class={`fai-avatar h-9 w-9 text-[15px] ${variant === 'find' ? 'fai-avatar--find' : 'fai-avatar--known'}`}
      aria-hidden="true"
    >{initials.slice(0, 1)}</span>
    <h3 class="fai-card-title min-w-0 text-fai-ink">
      <!-- Enlace estirado: en móvil el objetivo táctil es la tarjeta entera,
           no las 22px de alto que mide el texto del título. -->
      <a href={toolUrl(lang, tool.slug)} class="fai-card-link transition-colors hover:text-fai-signal">
        {tool.name}
      </a>
    </h3>
  </div>

  <!-- One-liner: dos líneas con altura mínima para que las tarjetas de una
       misma fila alineen su pie sin depender del largo del texto. -->
  <p class="mt-3 line-clamp-2 min-h-[42px] text-[14px] leading-[1.5] text-fai-muted">
    {tool.shortDescription}
  </p>

  <!-- Pie: dominio y badge en líneas separadas (columna, gap 9px) -->
  <div class="mt-auto flex flex-col gap-[9px] pt-4">
    <a
      href={toolUrl(lang, tool.slug)}
      class="fai-domain fai-card-above -mx-1 inline-flex min-h-11 w-fit max-w-full items-center gap-1 rounded-md px-1 transition-colors hover:text-fai-find sm:min-h-0"
    >
      {domain}
      <span class="sr-only">— {t('card.sheet')} {tool.name}</span>
      <svg class="h-3 w-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </a>

    {variant && (
      <span class={`fai-badge self-start ${variant === 'find' ? 'fai-badge--find' : 'fai-badge--known'}`}>
        {variant === 'find' ? t('badge.new-for-you') : t('badge.known')}
      </span>
    )}
  </div>
</article>
