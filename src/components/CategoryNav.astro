---
// src/components/CategoryNav.astro
// Índice de categorías. Antes sólo 5 de las 8 categorías eran alcanzables
// desde la navegación: las otras 3 quedaban huérfanas (sólo en el sitemap).
import { CATEGORIES, type Lang } from '../utils/brand';

interface Props {
  lang: Lang;
  tools: any[];
  /** Categoría actual, para marcarla como página activa */
  current?: string;
  columns?: 2 | 4;
}

const { lang, tools, current, columns = 4 } = Astro.props;

const items = CATEGORIES.map((cat) => ({
  ...cat,
  count: tools.filter((tool) => tool.categories.includes(cat.slug)).length
})).filter((cat) => cat.count > 0 || cat.slug === current);
---

<ul class={`grid gap-3 ${columns === 4 ? 'sm:grid-cols-2 lg:grid-cols-4' : 'sm:grid-cols-2'}`} role="list">
  {items.map((cat) => (
    <li>
      <a
        href={`/${lang}/categoria/${cat.slug}`}
        aria-current={cat.slug === current ? 'page' : undefined}
        class="group flex h-full flex-col gap-1.5 rounded-lg border border-brand-card-border bg-brand-surface p-4 transition-[border-color,background-color] hover:border-brand-text/25 hover:bg-brand-surface-sunken aria-[current=page]:border-brand-primary/50 aria-[current=page]:bg-brand-primary-soft"
      >
        <span class="flex items-center gap-2">
          <span class="h-2 w-2 shrink-0 rounded-full" style={`background:${cat.tone}`} aria-hidden="true"></span>
          <span class="text-[14px] font-semibold text-brand-text">{cat.label[lang]}</span>
          <span class="data-tag ml-auto text-brand-text-subtle">{cat.count}</span>
        </span>
        <span class="text-[13px] leading-5 text-brand-text-muted">{cat.blurb[lang]}</span>
      </a>
    </li>
  ))}
</ul>
