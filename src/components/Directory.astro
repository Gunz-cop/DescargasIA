---
// src/components/Directory.astro
// §6 SearchBar + NeedChips + CountHeadline + ResultGrid.
// Todos los conteos se derivan del catálogo; ninguno está escrito a mano.
import ToolCard from './ToolCard.astro';
import AdSlot from './AdSlot.astro';
import { CATEGORIES, PLATFORM_ORDER, type Lang } from '../utils/brand';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
  tools: any[];
}

const { lang, tools } = Astro.props;
const t = useTranslations(lang);

// Sólo se ofrecen necesidades que realmente tienen fichas verificadas.
const needs = CATEGORIES.map((cat) => ({
  ...cat,
  count: tools.filter((tool) => tool.categories.includes(cat.slug)).length
})).filter((cat) => cat.count > 0);

const usedPlatforms = PLATFORM_ORDER.filter((platform) =>
  tools.some((tool) => Boolean(tool.platforms[platform]))
);

const freeCount = tools.filter((tool) => tool.pricingModel === 'free').length;

const platformShort: Record<string, string> = {
  web: t('platform.short.web'),
  windows: t('platform.short.windows'),
  mac: t('platform.short.mac'),
  linux: t('platform.short.linux'),
  android: t('platform.short.android'),
  ios: t('platform.short.ios')
};

// §3.3 — el contador arranca en 2 ("la mayoría conoce 2") y sube al total.
const KNOWN_BASELINE = 2;
const allLabel = lang === 'sv' ? 'alla behov' : lang === 'it' ? 'tutte le necessità' : 'todas las necesidades';
---

<section id="directorio" class="scroll-mt-24 pb-12 pt-7 sm:pt-12" aria-labelledby="directorio-title">
  <h2 id="directorio-title" class="sr-only">{t('directory.title')}</h2>

  <!-- Buscador -->
  <div class="fai-search fai-live mx-auto flex max-w-[720px] items-center gap-3 rounded-[14px] px-4 py-3">
    <span class="fai-mono-sm shrink-0 text-fai-muted-2" aria-hidden="true">
      {lang === 'sv' ? 'Sök' : lang === 'it' ? 'Cerca' : 'Buscar'}
    </span>
    <label for="directory-search" class="sr-only">{t('search.label')}</label>
    <!-- 16px evita el zoom automático de iOS al enfocar. `enterkeyhint` pone
         "buscar" en la tecla de acción del teclado móvil. -->
    <input
      type="search"
      id="directory-search"
      placeholder={t('search.placeholder')}
      autocomplete="off"
      autocapitalize="off"
      autocorrect="off"
      spellcheck="false"
      enterkeyhint="search"
      aria-describedby="directory-search-hint"
      aria-controls="tools-grid"
      class="min-w-0 flex-1 bg-transparent py-2.5 text-[16px] text-fai-ink placeholder:text-fai-muted-2 focus:outline-none"
    />
    <!-- §3.5 Cursor del buscador: sólo visible cuando el campo tiene foco -->
    <span class="fai-caret shrink-0" aria-hidden="true"></span>
    <p id="directory-search-hint" class="sr-only">{t('search.hint')}</p>
    <span class="fai-mono-sm hidden shrink-0 text-fai-muted-2 sm:inline">
      ↵ · esc
    </span>
    <button
      type="button"
      id="clear-search"
      hidden
      class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-md text-fai-muted-2 transition-colors hover:text-fai-ink"
      aria-label={t('search.clear')}
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- El buscador va primero; la publicidad no debe ser lo primero que la
       persona vea al entrar. -->
  <AdSlot slotId="ad-home-top" format="bar" network="banner-320x50" eager class="mx-auto mt-6 max-w-[720px]" />

  <!-- §6 NeedChips -->
  <div class="mt-7 flex flex-wrap justify-center gap-2.5" id="need-chips" role="group" aria-label={t('filters.category')}>
    <button type="button" class="fai-chip" data-category="todos" aria-pressed="true">
      {t('filters.all')}
      <span class="fai-chip__count">{tools.length}</span>
    </button>
    {needs.map((need) => (
      <button type="button" class="fai-chip" data-category={need.slug} aria-pressed="false">
        {need.short[lang]}
        <span class="fai-chip__count">{need.count}</span>
      </button>
    ))}
  </div>

  <!-- §6 CountHeadline -->
  <div class="mt-10 flex flex-col gap-5 border-t border-fai-line pt-7 sm:mt-12 lg:flex-row lg:items-start lg:justify-between">
    <!-- El margen de desplazamiento cubre cabecera (64px) + barra de contexto
         (44px); con el valor por defecto el subtítulo quedaba tapado. -->
    <div id="conteo" class="scroll-mt-[7.5rem] lg:scroll-mt-24">
      <p class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
        <span
          class="fai-count"
          id="results-count"
          data-count-to={tools.length}
          data-count-from={KNOWN_BASELINE}
        >{tools.length}</span>
        <span class="fai-section-title text-fai-ink">
          {t('count.for')} <span id="need-label">{allLabel}</span>
        </span>
      </p>
      <p class="fai-mono-sm mt-2.5 text-fai-muted-2">
        {t(Math.max(tools.length - KNOWN_BASELINE, 0) === 1 ? 'count.most-know.one' : 'count.most-know.other')} <span id="missing-count">{Math.max(tools.length - KNOWN_BASELINE, 0)}</span>
      </p>
    </div>

    <!-- Filtros secundarios: sólo sobre datos que el catálogo ya verifica -->
    <div class="scrollbar-none -mx-1 flex gap-2 overflow-x-auto px-1 pb-1 lg:mx-0 lg:flex-wrap lg:overflow-visible lg:px-0 lg:pb-0" id="secondary-filters" role="group" aria-label={t('filters.platform')}>
      {freeCount > 0 && (
        <button type="button" class="fai-chip shrink-0 !px-3.5 !text-[13px] sm:!min-h-9" data-pricing="free" aria-pressed="false">
          {t('info.pricing.free')}
          <span class="fai-chip__count">{freeCount}</span>
        </button>
      )}
      {usedPlatforms.map((platform) => (
        <button type="button" class="fai-chip shrink-0 !px-3.5 !text-[13px] sm:!min-h-9" data-platform={platform} aria-pressed="false">
          {platformShort[platform]}
        </button>
      ))}
    </div>
  </div>

  <p id="results-live" class="sr-only" role="status" aria-live="polite"></p>

  <!--
    Barra de contexto (sólo móvil). Cuando los chips salen de pantalla no hay
    forma de saber qué filtro está puesto ni de cambiarlo sin volver arriba.
    Aparece al desplazarse más allá de los chips y lleva de vuelta a ellos.
  -->
  <button
    type="button"
    id="context-bar"
    {/* El prefijo webkit va como utilidad y no dentro de .fai-context porque
        Lightning CSS (Vite 8) fusiona las reglas del mismo selector y descarta
        una de las dos. Hace falta porque sus targets llegan a Safari 16.4 y
        backdrop-filter sin prefijo no existio hasta Safari 18. */}
    class="fai-context lg:hidden [-webkit-backdrop-filter:blur(12px)]"
    aria-controls="need-chips"
  >
    <span class="fai-mono-sm shrink-0 text-fai-muted-2">{t('filters.category')}</span>
    <span id="context-label" class="min-w-0 flex-1 truncate text-left text-[14px] font-medium text-fai-ink">
      {t('filters.all')}
    </span>
    <span class="fai-mono-sm shrink-0 text-fai-find" id="context-count">{tools.length}</span>
    <svg class="h-4 w-4 shrink-0 text-fai-muted-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="m18 15-6-6-6 6" />
    </svg>
  </button>

  <!-- §6 ResultGrid -->
  <div id="tools-grid" class="fai-grid mt-7">
    {tools.map((tool, index) => <ToolCard tool={tool} index={index} />)}
  </div>

  <div
    id="empty-state"
    hidden
    class="mt-7 rounded-[14px] border border-dashed border-fai-line px-6 py-16 text-center"
  >
    <p class="fai-section-title text-fai-ink">{t('empty.title')}</p>
    <p class="mx-auto mt-2.5 max-w-sm text-[14px] leading-[1.55] text-fai-muted">{t('empty.body')}</p>
    <button
      type="button"
      id="empty-reset"
      class="fai-chip mt-6 !bg-fai-find !border-fai-find !text-[#06231c] font-semibold"
    >
      {t('filters.reset')}
    </button>
  </div>
</section>

<script src="../scripts/directory.ts"></script>
