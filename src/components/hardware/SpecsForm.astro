---
import Tooltip from './Tooltip.astro';
import { useTranslations } from '../../i18n/ui';
import type { Lang } from '../../utils/brand';

interface Props {
  lang: Lang;
  action: string;
}

const { lang, action } = Astro.props;
const t = useTranslations(lang);
---

<form
  action={action}
  method="get"
  class="hardware-form rounded-2xl border border-fai-line bg-fai-surface p-5 sm:p-7"
  data-hardware-form
  novalidate
>
  <div class="max-w-2xl">
    <h2 id="hardware-app-title" class="text-[22px] font-semibold tracking-[-0.02em] text-fai-ink sm:text-[26px]">
      {t('hw.step1.title')}
    </h2>
    <p class="mt-2 text-[15px] leading-7 text-fai-muted">{t('hw.page.form.description')}</p>
  </div>

  <div class="mt-6 grid min-w-0 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <label class="grid min-w-0 gap-2 sm:col-span-2 lg:col-span-3" for="hardware-free-input">
      <span class="text-[14px] font-medium text-fai-ink">{t('hw.step1.free-label')}</span>
      <input
        id="hardware-free-input"
        name="gpu"
        type="text"
        autocomplete="off"
        placeholder={t('hw.step1.free-placeholder')}
        class="hardware-input min-w-0 rounded-lg border border-fai-line bg-fai-card px-3 text-fai-ink placeholder:text-fai-muted-2"
        role="combobox"
        aria-expanded="false"
        aria-controls="hardware-gpu-options"
        aria-haspopup="listbox"
        aria-activedescendant=""
        aria-describedby="hardware-combobox-help"
        data-hardware-free-input
      />
      <ul id="hardware-gpu-options" class="hardware-combobox-list" role="listbox" hidden data-hardware-options></ul>
      <span id="hardware-combobox-help" class="text-[14px] leading-6 text-fai-muted" data-hardware-combobox-help>
        {t('hw.combo.hint')}
      </span>
    </label>

    <div class="flex flex-wrap items-center gap-3 sm:col-span-2 lg:col-span-3">
      <button type="button" class="hardware-secondary-button" data-hardware-detect hidden>
        {t('hw.step1.detect')}
      </button>
      <span class="hardware-detected-note" data-hardware-detected-note hidden>
        <span class="hardware-detected-dot" aria-hidden="true"></span>
        <span data-hardware-detected-label>{t('hw.detected')}</span>
      </span>
    </div>

    <details class="hardware-details sm:col-span-2 lg:col-span-3" data-hardware-details>
      <summary class="hardware-details__summary">
        <span>{t('hw.step1.detailed')}</span>
        <span class="details-marker" aria-hidden="true">⌄</span>
      </summary>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <label class="grid min-w-0 gap-2 sm:col-span-2" for="hardware-gpu-detail">
          <span class="hardware-label">{t('hw.field.gpu')}</span>
          <input id="hardware-gpu-detail" type="text" class="hardware-input min-w-0 rounded-lg border border-fai-line bg-fai-card px-3 text-fai-ink" data-hardware-detail-gpu />
        </label>
        <label class="grid min-w-0 gap-2" for="hardware-vram">
          <span class="hardware-label inline-flex items-center gap-2">
            {t('hw.field.vram')}
            <Tooltip id={`hw-tooltip-${lang}-vram`} label={t('hw.tooltip.vram-label')} content={t('hw.tooltip.vram')} />
          </span>
          <input id="hardware-vram" name="vram" type="number" min="1" step="0.1" inputmode="decimal" placeholder="8" class="hardware-input min-w-0 rounded-lg border border-fai-line bg-fai-card px-3 text-fai-ink" data-hardware-vram />
        </label>
        <label class="grid min-w-0 gap-2" for="hardware-ram">
          <span class="hardware-label">{t('hw.field.ram')}</span>
          <input id="hardware-ram" name="ram" type="number" min="1" step="1" inputmode="numeric" placeholder="16" class="hardware-input min-w-0 rounded-lg border border-fai-line bg-fai-card px-3 text-fai-ink" data-hardware-ram />
        </label>
        <label class="grid min-w-0 gap-2" for="hardware-cpu">
          <span class="hardware-label">{t('hw.field.cpu')}</span>
          <input id="hardware-cpu" name="cpu" type="text" class="hardware-input min-w-0 rounded-lg border border-fai-line bg-fai-card px-3 text-fai-ink" data-hardware-cpu />
        </label>
        <label class="grid min-w-0 gap-2" for="hardware-os">
          <span class="hardware-label">{t('hw.field.os')}</span>
          <select id="hardware-os" name="os" class="hardware-input min-w-0 rounded-lg border border-fai-line bg-fai-card px-3 text-fai-ink" data-hardware-os>
            <option value="">{t('hw.page.form.os.any')}</option>
            <option value="windows">Windows</option>
            <option value="macos">macOS</option>
            <option value="linux">Linux</option>
          </select>
        </label>
      </div>
    </details>
  </div>

  <details class="hardware-vram-help mt-5">
    <summary class="hardware-details__summary">
      <span>{t('hw.vram.help')}</span>
      <span class="details-marker" aria-hidden="true">⌄</span>
    </summary>
    <div class="mt-4 grid gap-3 text-[14px] leading-6 text-fai-muted sm:grid-cols-3">
      <div>
        <p class="hardware-command-label">Windows</p>
        <code class="hardware-command">nvidia-smi --query-gpu=name,memory.total --format=csv</code>
      </div>
      <div>
        <p class="hardware-command-label">{t('hw.vram.windows-alt')}</p>
        <code class="hardware-command">wmic path win32_VideoController get name,AdapterRAM</code>
      </div>
      <div>
        <p class="hardware-command-label">macOS</p>
        <code class="hardware-command">system_profiler SPDisplaysDataType</code>
      </div>
    </div>
    <p class="mt-3 text-[14px] leading-6 text-fai-muted-2">{t('hw.vram.paste-help')}</p>
  </details>

  <div class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-fai-line pt-5">
    <p class="max-w-2xl text-[14px] leading-6 text-fai-muted-2">{t('hw.privacy')}</p>
    <button type="submit" class="hardware-primary-button">{t('hw.page.form.submit')}</button>
  </div>
</form>
