---
import { useTranslations } from '../../i18n/ui';
import type { Lang } from '../../utils/brand';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<template data-hardware-result-template>
  <article class="hardware-result-card fai-live" data-hardware-result-card>
    <header class="flex items-start justify-between gap-4">
      <div class="min-w-0">
        <h3 class="hardware-result-card__title" data-result="name"></h3>
        <p class="mt-1 text-[14px] text-fai-muted" data-result="size"></p>
      </div>
      <span class="hardware-verdict" data-result="verdict"></span>
    </header>

    <div class="mt-5">
      <div class="hardware-memory-bar" aria-hidden="true" data-result="memory-bar">
        <span class="hardware-memory-bar__segment hardware-memory-bar__segment--weights" data-segment="weights"></span>
        <span class="hardware-memory-bar__segment hardware-memory-bar__segment--kv" data-segment="kv"></span>
        <span class="hardware-memory-bar__segment hardware-memory-bar__segment--overhead" data-segment="overhead"></span>
      </div>
      <dl class="hardware-breakdown mt-3">
        <div><dt>{t('hw.result.weights')}</dt><dd data-result="weights"></dd></div>
        <div><dt>{t('hw.result.kv-cache')}</dt><dd data-result="kv"></dd></div>
        <div><dt>{t('hw.result.overhead')}</dt><dd data-result="overhead"></dd></div>
        <div class="hardware-breakdown__total"><dt>{t('hw.result.total')}</dt><dd data-result="total"></dd></div>
      </dl>
      <p class="mt-2 text-[13px] leading-5 text-fai-muted-2" data-result="available"></p>
    </div>

    <div class="mt-5 grid gap-2 border-t border-fai-line pt-4 sm:grid-cols-2">
      <p class="text-[14px] text-fai-ink"><span class="text-fai-muted">{t('hw.result.quant')}:</span> <code class="font-mono text-fai-signal" data-result="quant"></code></p>
      <p class="text-[14px] text-fai-ink"><span class="text-fai-muted">{t('hw.result.speed')}:</span> <span class="font-mono text-fai-find" data-result="speed"></span></p>
    </div>
    <p class="mt-2 text-[13px] leading-5 text-fai-muted-2" data-result="reason"></p>

    <nav class="hardware-runtime-links mt-5 flex flex-wrap gap-2" aria-label={t('hw.result.runtime-links')}>
      <a href="#" class="hardware-runtime-link" data-runtime-link="ollama" hidden>Ollama</a>
      <a href="#" class="hardware-runtime-link" data-runtime-link="lm-studio" hidden>LM Studio</a>
      <a href="#" class="hardware-runtime-link" data-runtime-link="jan" hidden>Jan</a>
    </nav>
  </article>
</template>
