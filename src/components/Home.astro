---
// src/components/Home.astro — §6, home por necesidad (dirección 1a)
import BaseLayout from '../layouts/BaseLayout.astro';
import Directory from './Directory.astro';
import { getTranslatedTools } from '../utils/tools';
import { CATEGORIES, getDomain, type Lang } from '../utils/brand';
import { homeUrl, toolUrl, categoryUrl, hardwareUrl, absolute, buildAlternates } from '../utils/links';
import { useTranslations, languages } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const tools = await getTranslatedTools(lang);

// Canal oficial primero; a igualdad de confianza, alfabético.
const trustPriority = { official: 3, verified: 2, 'pending-review': 1 } as const;
const sortedTools = [...tools].sort((a, b) => {
  const diff = (trustPriority[b.trustLevel] ?? 0) - (trustPriority[a.trustLevel] ?? 0);
  return diff !== 0 ? diff : a.name.localeCompare(b.name, lang);
});

const pageTitle = lang === 'sv'
  ? 'Ladda ner AI-verktyg från officiella källor | FuenteAI'
  : lang === 'it'
    ? 'Scarica strumenti IA da fonti ufficiali | FuenteAI'
    : 'Descarga IA desde canales oficiales | FuenteAI';

const pageDesc = lang === 'sv'
  ? 'Officiellt källindex för AI-verktyg som ChatGPT, Gemini, Claude, Ollama och Cursor. Inga spegelsajter, inga modifierade filer.'
  : lang === 'it'
    ? 'Indice editoriale delle fonti ufficiali per strumenti IA come ChatGPT, Gemini, Claude, Ollama e Cursor. Senza specchi né installer modificati.'
    : 'Índice de fuentes oficiales para herramientas de IA como ChatGPT, Gemini, Claude, Ollama y Cursor. Sin mirrors ni instaladores modificados.';

const verifiedDomainsCount = new Set(
  tools.map((tool) => getDomain(tool.officialWebsite)).filter(Boolean)
).size;

const origin = Astro.url.origin;

const schemaItemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: t('hero.title'),
  description: t('hero.subtitle'),
  numberOfItems: sortedTools.length,
  itemListElement: sortedTools.map((tool, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: absolute(origin, toolUrl(lang, tool.slug)),
    name: tool.name
  }))
};

const schemaWebsite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'FuenteAI',
  url: origin,
  inLanguage: lang,
  description: pageDesc
};

// Autorreferencial: la portada de cada idioma se lista a si misma ademas de
// a las otras dos (requisito de Google para que el bloque hreflang valga).
const alternates = buildAlternates(origin, (l) => homeUrl(l));

const canonicalUrl = absolute(origin, homeUrl(lang));

// Enlaces reales (no botones) a las paginas de necesidad. Los chips del
// directorio filtran en cliente y no son rastreables; este bloque es el que
// da a cada categoria un enlace en el CUERPO de la portada, con texto de
// ancla descriptivo, no solo la repeticion de la cabecera.
const needLinks = CATEGORIES.map((cat) => ({
  slug: cat.slug,
  href: categoryUrl(lang, cat.slug),
  label: cat.label[lang],
  blurb: cat.blurb[lang],
  count: tools.filter((tool) => tool.categories.includes(cat.slug)).length
})).filter((cat) => cat.count > 0);

const needsHeading = lang === 'sv'
  ? 'Bläddra efter behov'
  : lang === 'it'
    ? 'Esplora per necessità'
    : 'Explora por necesidad';

const needsIntro = lang === 'sv'
  ? 'Varje sida samlar de verifierade verktygen för ett behov, med den officiella källan för vart och ett.'
  : lang === 'it'
    ? 'Ogni pagina raccoglie gli strumenti verificati per una necessità, con la fonte ufficiale di ciascuno.'
    : 'Cada página reúne las herramientas verificadas para una necesidad, con la fuente oficial de cada una.';

const needsCta = lang === 'sv' ? 'verktyg' : lang === 'it' ? 'strumenti' : 'herramientas';

const eyebrow = lang === 'sv'
  ? 'Katalog över officiella AI-källor'
  : lang === 'it'
    ? 'Directory di fonti ufficiali di IA'
    : 'Directorio de fuentes oficiales de IA';
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  jsonLd={[schemaWebsite, schemaItemList]}
  lang={lang}
  alternates={alternates}
  canonicalUrl={canonicalUrl}
>
  <!-- En móvil el hero se compacta: la acción principal (buscar y elegir
       necesidad) tiene que entrar en la primera pantalla, no a 550px. -->
  <section class="pb-2 pt-8 text-center sm:pt-20" aria-labelledby="hero-title">
    <p class="fai-mono-sm text-fai-signal">{eyebrow}</p>

    <h1 id="hero-title" class="fai-hero mx-auto mt-4 max-w-[16ch] text-fai-ink sm:mt-6">
      {t('home.question')}
    </h1>

    <p class="mx-auto mt-4 max-w-[58ch] text-[16px] leading-[1.5] text-fai-muted sm:mt-6 sm:text-[17px] sm:leading-[1.55]">
      {t('home.answer')}
    </p>

    <!-- Las cifras van con separadores en línea: en móvil el tracking del mono
         las partía en tres renglones y empujaban el buscador fuera de vista. -->
    <p class="fai-mono-sm mt-5 flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-fai-muted-2 sm:mt-7 sm:gap-x-3">
      <span class="whitespace-nowrap">{sortedTools.length} {t('home.verified-sources')}</span>
      <span aria-hidden="true">·</span>
      <span class="whitespace-nowrap">{verifiedDomainsCount} {t('home.stat.domains')}</span>
      <span aria-hidden="true">·</span>
      <span class="whitespace-nowrap">0 {t('home.stat.hosted')}</span>
    </p>
  </section>

  <Directory lang={lang} tools={sortedTools} />

  <!-- Enlazado interno: portada -> paginas de necesidad. Ver docs/enlazado-interno.md -->
  <section class="border-t border-fai-line pt-12" aria-labelledby="necesidades-title">
    <h2 id="necesidades-title" class="fai-section-title text-fai-ink">{needsHeading}</h2>
    <p class="mt-2.5 max-w-[62ch] text-[14px] leading-[1.55] text-fai-muted">{needsIntro}</p>

    <div class="mt-7 grid gap-2.5 sm:grid-cols-2 lg:grid-cols-4">
      {needLinks.map((need) => (
        <a
          href={need.href}
          class="fai-live flex h-full flex-col rounded-[14px] p-4 transition-colors hover:border-[rgba(15,191,143,.5)]"
        >
          <span class="text-[15px] font-medium text-fai-ink">{need.label}</span>
          <span class="mt-1.5 text-[13px] leading-[1.5] text-fai-muted">{need.blurb}</span>
          <span class="fai-mono-sm mt-3 text-fai-find">{need.count} {needsCta} &rarr;</span>
        </a>
      ))}
    </div>
  </section>

  <section class="mt-12 rounded-2xl border border-[rgba(15,191,143,.28)] bg-[linear-gradient(150deg,rgba(15,191,143,.12),rgba(15,191,143,.03))] p-5 sm:flex sm:items-center sm:justify-between sm:gap-8 sm:p-7" aria-labelledby="hardware-home-title">
    <div class="max-w-2xl">
      <p class="fai-mono-sm text-fai-signal">{t('hw.nav')}</p>
      <h2 id="hardware-home-title" class="mt-2 text-[22px] font-semibold tracking-[-0.02em] text-fai-ink">{t('hw.page.title')}</h2>
      <p class="mt-2 text-[14px] leading-6 text-fai-muted">{t('hw.page.description')}</p>
    </div>
    <a href={hardwareUrl(lang)} class="mt-5 inline-flex min-h-11 shrink-0 items-center justify-center rounded-[8px] bg-fai-find px-4 text-[13px] font-semibold !text-[#06231c] transition-opacity hover:opacity-90 sm:mt-0">
      {t('hw.nav')} <span aria-hidden="true" class="ml-1.5">→</span>
    </a>
  </section>
</BaseLayout>
